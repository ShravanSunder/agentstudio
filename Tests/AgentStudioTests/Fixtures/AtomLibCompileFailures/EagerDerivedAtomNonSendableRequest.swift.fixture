private class EagerDerivedAtomNonSendableRequest {
    var value = 0
}

@MainActor
private func buildEagerDerivedAtomWithNonSendableRequest() {
    _ = EagerDerivedAtom<EagerDerivedAtomNonSendableRequest, Int, Int, Int, Int>(
        intentIdentity: { $0.value },
        combinePendingIntents: { _, latestIntent in latestIntent },
        prepare: { intent, _ in .prepared(intent.value) },
        project: { $0 },
        classify: { candidate, currentValue in
            currentValue == candidate ? .equalCurrent(candidate) : .immediateAccepted(candidate)
        }
    )
}
