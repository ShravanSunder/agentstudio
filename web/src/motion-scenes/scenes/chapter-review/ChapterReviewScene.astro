---
import { sceneRootAttribute } from "@/chapters/chapter-dom-contract";
import AppWindow from "@/recreation-kit/AppWindow.astro";
import DiffView from "@/recreation-kit/DiffView.astro";
import FileTree from "@/recreation-kit/FileTree.astro";
import Pane from "@/recreation-kit/Pane.astro";
import { scenePartAttributes } from "@/recreation-kit/recreation-kit-dom";

import {
  reviewAccessibleLabel,
  reviewDiff,
  reviewFiles,
  reviewFooter,
  reviewParts,
  reviewToolbar,
} from "./chapter-review-fixture";

const sceneRootAttributes = { [sceneRootAttribute]: "chapter-review" };
---

<AppWindow
  {...sceneRootAttributes}
  class="scene-review"
  role="img"
  aria-label={reviewAccessibleLabel}
  toolbar={reviewToolbar}
>
  <Pane footer={reviewFooter} phoneRole="shown">
    <div class="scene-review__main" {...scenePartAttributes(reviewParts.diffView)}>
      <DiffView diff={reviewDiff} />
      <aside class="scene-review__comment" {...scenePartAttributes(reviewParts.commentThread)}>
        <div class="scene-review__comment-heading">Review comment · line 49</div>
        <p><strong>Keep the comparison dated.</strong> The <code>current.md</code> pin can stay brief.</p>
      </aside>
    </div>
  </Pane>
  <FileTree rows={reviewFiles} currentView="review" phoneRole="hidden" />
</AppWindow>

<style is:global>
  .scene-review__main {
    position: relative;
    display: flex;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
  }
  .scene-review .kit-pane__content { display: flex; }
  .scene-review [data-scene-part="review-changed-line"] {
    box-shadow: inset 0 0 0 1px rgb(137 180 250 / 80%);
  }
  .scene-review__comment {
    position: absolute;
    z-index: 2;
    top: 30%;
    right: 3%;
    width: min(45%, 25em);
    padding: 0.8em 1em;
    border: 1px solid rgb(137 180 250 / 58%);
    border-radius: 0.7em;
    background: rgb(39 43 52 / 94%);
    box-shadow: 0 0.8em 2em rgb(0 0 0 / 35%);
    color: var(--kit-text);
  }
  .scene-review__comment-heading {
    margin-bottom: 0.45em;
    color: var(--kit-primary);
    font-weight: 650;
  }
  .scene-review__comment p { margin: 0; line-height: 1.45; }
  .scene-review__comment code { color: var(--kit-added); }
  @container recreation-kit (max-width: 600px) {
    .scene-review__comment {
      top: 47%;
      right: 4%;
      width: 78%;
      font-size: 0.9em;
    }
  }
</style>
