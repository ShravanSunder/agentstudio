---
import { sceneRootAttribute } from "@/chapters/chapter-dom-contract";
import AgentTerminal from "@/recreation-kit/AgentTerminal.astro";
import AppWindow from "@/recreation-kit/AppWindow.astro";
import Pane from "@/recreation-kit/Pane.astro";
import PaneGrid from "@/recreation-kit/PaneGrid.astro";
import { scenePartAttributes } from "@/recreation-kit/recreation-kit-dom";

import {
  comeBackAccessibleLabel,
  comeBackFooter,
  comeBackLeftTerminal,
  comeBackParts,
  comeBackRightTerminal,
  comeBackToolbar,
} from "./chapter-come-back-fixture";

const sceneRootAttributes = { [sceneRootAttribute]: "chapter-come-back" };
---

<AppWindow
  {...sceneRootAttributes}
  class="scene-come-back"
  role="img"
  aria-label={comeBackAccessibleLabel}
  toolbar={comeBackToolbar}
>
  <PaneGrid>
    <Pane footer={comeBackFooter} phoneRole="shown">
      <AgentTerminal lines={comeBackLeftTerminal} scenePart={comeBackParts.leftTerminal} />
      <span class="scene-come-back__counter" {...scenePartAttributes(comeBackParts.processCounter)}>
        process uptime 00:16
      </span>
    </Pane>
    <Pane footer={comeBackFooter} phoneRole="hidden">
      <AgentTerminal lines={comeBackRightTerminal} scenePart={comeBackParts.rightTerminal} />
    </Pane>
  </PaneGrid>
</AppWindow>

<style is:global>
  .scene-come-back {
    transform-origin: center;
  }
  .scene-come-back__counter {
    position: absolute;
    right: 1em;
    bottom: 3.2em;
    padding: 0.35em 0.55em;
    border: 1px solid rgb(166 227 161 / 40%);
    border-radius: 0.3em;
    background: rgb(30 30 46 / 84%);
    color: var(--kit-added);
    font-family: var(--kit-font-mono);
    white-space: nowrap;
  }
</style>
