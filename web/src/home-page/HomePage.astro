---
import ChapterStage from "@/chapters/ChapterStage.astro";
import ChapterSurface from "@/chapters/ChapterSurface.astro";
import { chapterCatalog } from "@/chapters/chapter-catalog";
import FinalGitHubCallToAction from "@/home-page/FinalGitHubCallToAction.astro";
import Hero from "@/home-page/Hero.astro";
import { marketingCopy } from "@/marketing-copy";
import { siteMetadata } from "@/site-metadata";
import SiteFooter from "@/site-shell/SiteFooter.astro";
import SiteShell from "@/site-shell/SiteShell.astro";

interface Props {
  readonly canonicalPath?: string | undefined;
  readonly socialUrlPath?: string | undefined;
}

const { canonicalPath, socialUrlPath } = Astro.props;
---

<SiteShell
  title={siteMetadata.homeTitle}
  description={marketingCopy.hero.description}
  canonicalPath={canonicalPath}
  socialUrlPath={socialUrlPath}
>
  <Hero />
  {
    chapterCatalog.map((chapter) => (
      <ChapterSurface chapter={chapter}>
        <ChapterStage slot="stage" chapter={chapter} />
      </ChapterSurface>
    ))
  }
  <FinalGitHubCallToAction />
  <SiteFooter />
</SiteShell>
