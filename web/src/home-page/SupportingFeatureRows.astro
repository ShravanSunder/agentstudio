---
import { Image } from "astro:assets";

import arrangementSavedImage from "@/assets/captures/arrangement-saved.png";
import paneZoomImage from "@/assets/captures/pane-zoom.png";
import persistentBeforeImage from "@/assets/captures/persistence-claude-before.png";
import persistentRestoredImage from "@/assets/captures/persistence-claude-restored.png";
import reviewImage from "@/assets/captures/review.png";
import { marketingCopy } from "@/marketing-copy";
import PersistenceProof from "@/product-plate/PersistenceProof.astro";

const mediaByFeatureId = {
  "pane-types": reviewImage,
} as const;
---

<section class="feature-details px-page-inline pt-section" aria-labelledby="feature-details-title">
  <div class="section-heading mb-content max-w-section-heading">
    <p class="eyebrow m-0 font-mono-product text-eyebrow tracking-eyebrow text-ink-faint uppercase">
      {marketingCopy.featureDetails.eyebrow}
    </p>
    <h2
      id="feature-details-title"
      class="mt-3.5 mb-5 font-display text-section-title font-extrabold"
    >
      {marketingCopy.featureDetails.headline}
    </h2>
    <p class="m-0 max-w-copy text-marketing-body text-ink-muted">
      {marketingCopy.featureDetails.description}
    </p>
  </div>

  <div class="border-t border-line-strong">
    {
      marketingCopy.featureDetails.items.map((item) => (
        <article class="feature-detail grid grid-cols-[minmax(240px,0.7fr)_minmax(0,1.3fr)] items-center gap-[clamp(40px,5vw,76px)] border-b border-line-strong py-[clamp(48px,5vw,76px)] max-phone:grid-cols-1 max-phone:gap-7 max-phone:py-10">
          <div class="feature-detail__copy max-w-[440px] max-phone:max-w-[680px]">
            <h3 class="m-0 text-[clamp(28px,3.2vw,48px)] leading-none tracking-[-0.045em] text-ink max-phone:text-[clamp(30px,9vw,44px)]">
              {item.title}
            </h3>
            <p class="mt-5.5 mb-0 text-marketing-body text-ink-secondary max-phone:text-[16px]">
              {item.summary}
            </p>
            <p class="mt-3 mb-0 text-[17px] leading-[1.55] text-ink-muted max-phone:text-[16px]">
              {item.detail}
            </p>
          </div>

          <div class="feature-detail__media min-w-0 overflow-clip rounded-product border border-line-strong bg-product-ground">
            {item.id === "persistence" ? (
              <PersistenceProof
                beforeImage={persistentBeforeImage}
                restoredImage={persistentRestoredImage}
              />
            ) : item.id === "arrangements" ? (
              <PersistenceProof
                beforeImage={arrangementSavedImage}
                restoredImage={paneZoomImage}
                beforeLabel={item.savedArrangementLabel}
                restoredLabel={item.paneZoomLabel}
                beforeImageDescription={item.savedArrangementImageDescription}
                restoredImageDescription={item.paneZoomImageDescription}
                accessibilityLabel="Workspace layout presentation"
              />
            ) : (
              <Image
                src={mediaByFeatureId[item.id]}
                alt={item.imageDescription}
                widths={[720, 1080, 1440, 2160]}
                sizes="(max-width: 900px) 100vw, 62vw"
                format="png"
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
