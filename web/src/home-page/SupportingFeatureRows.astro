---
import { Image } from "astro:assets";

import parallelWorkImage from "@/assets/captures/parallel-work.png";
import persistentBeforeImage from "@/assets/captures/persistent-before.png";
import persistentRestoredImage from "@/assets/captures/persistent-restored.png";
import reviewImage from "@/assets/captures/review.png";
import { marketingCopy } from "@/marketing-copy";
import PersistenceProof from "@/product-plate/PersistenceProof.astro";

const mediaByFeatureId = {
  arrangements: persistentRestoredImage,
  "pane-types": reviewImage,
  "agent-agnostic": parallelWorkImage,
} as const;
---

<section class="feature-details px-page-inline pt-section" aria-labelledby="feature-details-title">
  <div class="section-heading mb-content max-w-[900px]">
    <p class="eyebrow m-0 font-mono-product text-[12px] tracking-[0.12em] text-ink-faint uppercase">
      {marketingCopy.featureDetails.eyebrow}
    </p>
    <h2
      id="feature-details-title"
      class="mt-[14px] mb-[20px] font-display text-[clamp(48px,6.4vw,94px)] leading-[0.92] font-extrabold tracking-[-0.06em]"
    >
      {marketingCopy.featureDetails.headline}
    </h2>
    <p class="m-0 max-w-[700px] text-[19px] leading-[1.55] text-ink-muted">
      {marketingCopy.featureDetails.description}
    </p>
  </div>

  <div class="border-t border-line-strong">
    {
      marketingCopy.featureDetails.items.map((item) => (
        <article class="feature-detail grid grid-cols-[minmax(240px,0.7fr)_minmax(0,1.3fr)] items-center gap-[clamp(40px,5vw,76px)] border-b border-line-strong py-[clamp(48px,5vw,76px)] max-phone:grid-cols-1 max-phone:gap-[28px] max-phone:py-[40px]">
          <div class="feature-detail__copy max-w-[440px] max-phone:max-w-[680px]">
            <h3 class="m-0 text-[clamp(28px,3.2vw,48px)] leading-none tracking-[-0.045em] text-ink max-phone:text-[clamp(30px,9vw,44px)]">
              {item.title}
            </h3>
            <p class="mt-[22px] mb-0 text-[19px] leading-[1.55] text-ink-secondary max-phone:text-[16px]">
              {item.summary}
            </p>
            <p class="mt-[12px] mb-0 text-[17px] leading-[1.55] text-ink-muted max-phone:text-[16px]">
              {item.detail}
            </p>
          </div>

          <div class="feature-detail__media min-w-0 overflow-clip rounded-product border border-line-strong bg-product-ground">
            {item.id === "persistence" ? (
              <PersistenceProof
                beforeImage={persistentBeforeImage}
                restoredImage={persistentRestoredImage}
              />
            ) : (
              <Image
                src={mediaByFeatureId[item.id]}
                alt={item.imageDescription}
                widths={[720, 1080, 1440, 2160]}
                sizes="(max-width: 900px) 100vw, 62vw"
                format="png"
                loading="lazy"
                decoding="async"
                class="block h-auto w-full"
              />
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
