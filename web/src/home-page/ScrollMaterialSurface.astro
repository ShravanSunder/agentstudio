---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={["scroll-material-surface", className]}
  data-scroll-material-surface
  data-visual-state="resting"
>
  <slot />
</div>

<script>
  import { initializeScrollMaterialSurfaces } from "./scroll-material-surface-controller";

  initializeScrollMaterialSurfaces();
</script>

<style>
  .scroll-material-surface {
    --scroll-material-progress: 0;
    --scroll-material-lift: 0px;
    --scroll-material-border-color: rgb(137 180 250 / 0%);
    --scroll-material-primary-alpha: 0;
    --scroll-material-cyan-alpha: 0;
    --scroll-material-ground-alpha: 0;
    --scroll-material-shadow-alpha: 0;
    --scroll-material-secondary-shadow-alpha: 0;
    --scroll-material-highlight-alpha: 0;
    --scroll-material-blur: 0px;
    --scroll-material-saturation: 100%;
    --scroll-material-radius: 16px;
    --scroll-material-pane-background:
      linear-gradient(
        135deg,
        rgb(137 180 250 / var(--scroll-material-primary-alpha)),
        transparent 40%,
        rgb(116 199 236 / var(--scroll-material-cyan-alpha))
      ),
      rgb(24 26 32 / 72%);
    border-color: var(--scroll-material-border-color);
    border-radius: var(--scroll-material-radius);
    background:
      linear-gradient(
        135deg,
        rgb(137 180 250 / var(--scroll-material-primary-alpha)),
        transparent 40%,
        rgb(116 199 236 / var(--scroll-material-cyan-alpha))
      ),
      rgb(30 30 46 / var(--scroll-material-ground-alpha));
    box-shadow:
      0 20px 46px rgb(8 9 14 / var(--scroll-material-shadow-alpha)),
      0 6px 16px rgb(10 11 17 / var(--scroll-material-secondary-shadow-alpha)),
      0 1px 0 rgb(137 180 250 / var(--scroll-material-primary-alpha)),
      inset 0 1px rgb(255 255 255 / var(--scroll-material-highlight-alpha));
    transform: translate3d(0, var(--scroll-material-lift), 0);
    backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    -webkit-backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    will-change: transform;
  }

  :global(.scroll-material-pane) {
    background: var(--scroll-material-pane-background);
    box-shadow: inset 0 1px rgb(255 255 255 / var(--scroll-material-highlight-alpha));
    backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    -webkit-backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-material-surface {
      transform: none;
      will-change: auto;
    }
  }
</style>
