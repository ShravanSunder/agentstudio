---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  readonly staticMaterial?: boolean;
}

const { class: className, staticMaterial = false, ...attributes } = Astro.props;
---

<div
  {...attributes}
  class:list={[
    "scroll-material-surface",
    { "scroll-material-surface--static": staticMaterial },
    className,
  ]}
  data-scroll-material-surface={staticMaterial ? undefined : ""}
  data-visual-state={staticMaterial ? "floating" : "resting"}
>
  <slot />
</div>

<script>
  import { initializeScrollMaterialSurfaces } from "./scroll-material-surface-controller";

  initializeScrollMaterialSurfaces();
</script>

<style>
  .scroll-material-surface {
    --scroll-material-progress: 0;
    --scroll-material-lift: 0px;
    --scroll-material-border-color: rgb(137 180 250 / 0%);
    --scroll-material-primary-alpha: 0;
    --scroll-material-cyan-alpha: 0;
    --scroll-material-ground-alpha: 0;
    --scroll-material-shadow-alpha: 0;
    --scroll-material-secondary-shadow-alpha: 0;
    --scroll-material-highlight-alpha: 0;
    --scroll-material-blur: 0px;
    --scroll-material-saturation: 100%;
    --scroll-material-radius: 16px;
    --scroll-material-pane-background:
      linear-gradient(
        135deg,
        rgb(137 180 250 / var(--scroll-material-primary-alpha)),
        transparent 40%,
        rgb(116 199 236 / var(--scroll-material-cyan-alpha))
      ),
      rgb(24 26 32 / 72%);
    border-color: var(--scroll-material-border-color);
    border-radius: var(--scroll-material-radius);
    background:
      linear-gradient(
        135deg,
        rgb(137 180 250 / var(--scroll-material-primary-alpha)),
        transparent 40%,
        rgb(116 199 236 / var(--scroll-material-cyan-alpha))
      ),
      rgb(30 30 46 / var(--scroll-material-ground-alpha));
    box-shadow:
      0 20px 46px rgb(8 9 14 / var(--scroll-material-shadow-alpha)),
      0 6px 16px rgb(10 11 17 / var(--scroll-material-secondary-shadow-alpha)),
      0 1px 0 rgb(137 180 250 / var(--scroll-material-primary-alpha)),
      inset 0 1px rgb(255 255 255 / var(--scroll-material-highlight-alpha));
    transform: translate3d(0, var(--scroll-material-lift), 0);
    backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    -webkit-backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    will-change: transform;
  }

  .scroll-material-surface--static {
    --scroll-material-progress: 1;
    --scroll-material-lift: 0px;
    --scroll-material-border-color: rgb(137 180 250 / 38%);
    --scroll-material-primary-alpha: 0.11;
    --scroll-material-cyan-alpha: 0.06;
    --scroll-material-ground-alpha: 0.88;
    --scroll-material-shadow-alpha: 0.28;
    --scroll-material-secondary-shadow-alpha: 0.18;
    --scroll-material-highlight-alpha: 0.1;
    --scroll-material-blur: 20px;
    --scroll-material-saturation: 120%;
    --scroll-material-radius: 20px;
    transform: none;
    will-change: auto;
  }

  :global(.scroll-material-pane) {
    background: var(--scroll-material-pane-background);
    box-shadow: inset 0 1px rgb(255 255 255 / var(--scroll-material-highlight-alpha));
    backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
    -webkit-backdrop-filter: blur(var(--scroll-material-blur))
      saturate(var(--scroll-material-saturation));
  }

  :global(.scroll-material-selection-control) {
    --scroll-material-selection-dot-top: 21px;
    --scroll-material-selection-dot-right: 16px;
  }

  :global(.scroll-material-selection-control)::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    opacity: 0;
    background: rgb(8 10 15 / 82%);
    backdrop-filter: blur(16px) saturate(110%);
    -webkit-backdrop-filter: blur(16px) saturate(110%);
    transition: opacity 150ms ease-out;
  }

  :global(.scroll-material-selection-control)::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: var(--scroll-material-selection-dot-top);
    right: var(--scroll-material-selection-dot-right);
    width: 8px;
    height: 8px;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0;
    background: var(--color-primary);
  }

  :global(.scroll-material-selection-control:is([aria-selected="true"], [aria-pressed="true"], .is-default:disabled))::before {
    opacity: 1;
  }

  :global(.scroll-material-selection-control:is([aria-selected="true"], [aria-pressed="true"], .is-default:disabled))::after {
    animation: scroll-material-selection-dot-breathe 3.2s ease-in-out infinite;
  }

  @media (width < 64rem) {
    :global(.scroll-material-pane-compact) {
      background: var(--scroll-material-pane-background);
      box-shadow: inset 0 1px rgb(255 255 255 / var(--scroll-material-highlight-alpha));
      backdrop-filter: blur(var(--scroll-material-blur))
        saturate(var(--scroll-material-saturation));
      -webkit-backdrop-filter: blur(var(--scroll-material-blur))
        saturate(var(--scroll-material-saturation));
    }

    :global(.scroll-material-selection-control)::after {
      display: none;
    }
  }

  @media (width <= 620px) {
    .scroll-material-surface--static {
      --scroll-material-radius: 18px;
    }
  }

  @keyframes scroll-material-selection-dot-breathe {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-material-surface {
      transform: none;
      will-change: auto;
    }

    :global(.scroll-material-selection-control)::before {
      transition: none;
    }

    :global(.scroll-material-selection-control:is([aria-selected="true"], [aria-pressed="true"], .is-default:disabled))::after {
      animation: none;
      opacity: 0.8;
    }
  }
</style>
