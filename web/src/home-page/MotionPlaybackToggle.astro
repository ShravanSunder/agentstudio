---
interface Props {
  /** The data attribute the owning controller finds this control by. */
  readonly controlAttribute: "data-scene-playback-toggle" | "data-hero-loop-toggle";
  readonly pauseLabel: string;
  readonly playLabel: string;
  readonly class?: string;
}

const { controlAttribute, pauseLabel, playLabel, class: className } = Astro.props;
const controlAttributes = { [controlAttribute]: "" };
---

<!--
  A visitor's pause/play control for motion longer than five seconds (WCAG
  2.2.2). Hidden until its controller confirms motion can run; the controller
  sets data-playback-state and swaps the accessible name between the labels.
-->
<button
  {...controlAttributes}
  type="button"
  class:list={[
    "motion-playback-toggle grid size-9 cursor-pointer place-items-center rounded-full border border-line-strong bg-[rgb(17_17_27/78%)] text-ink-secondary backdrop-blur-md hover:text-ink",
    className,
  ]}
  data-pause-label={pauseLabel}
  data-play-label={playLabel}
  aria-label={playLabel}
  hidden
>
  <svg class="motion-playback-toggle__pause size-3.5" viewBox="0 0 14 14" aria-hidden="true">
    <rect x="2.5" y="2" width="3" height="10" rx="1" fill="currentColor"></rect>
    <rect x="8.5" y="2" width="3" height="10" rx="1" fill="currentColor"></rect>
  </svg>
  <svg class="motion-playback-toggle__play size-3.5" viewBox="0 0 14 14" aria-hidden="true">
    <path
      d="M4 2.2v9.6a.6.6 0 0 0 .92.5l7.3-4.8a.6.6 0 0 0 0-1L4.92 1.7A.6.6 0 0 0 4 2.2Z"
      fill="currentColor"></path>
  </svg>
</button>

<style>
  .motion-playback-toggle__play,
  .motion-playback-toggle[data-playback-state="playing"] .motion-playback-toggle__pause {
    display: block;
  }

  .motion-playback-toggle__pause,
  .motion-playback-toggle[data-playback-state="playing"] .motion-playback-toggle__play {
    display: none;
  }
</style>
