---
import { marketingCopy } from "@/marketing-copy";

import type { HeroLoopMedia } from "./hero-loop-media";
import MotionPlaybackToggle from "./MotionPlaybackToggle.astro";

interface Props {
  readonly media: HeroLoopMedia;
}

const { media } = Astro.props;
---

<!-- No autoplay attribute: the controller plays only when motion is allowed. -->
<div class="relative h-full w-full" data-hero-loop>
  <video
    class="block h-full w-full object-cover object-top"
    src={media.source}
    poster={media.poster.src}
    aria-label={media.accessibilityLabel}
    muted
    loop
    playsinline
    preload="metadata"
    data-hero-loop-video></video>
  <MotionPlaybackToggle
    controlAttribute="data-hero-loop-toggle"
    pauseLabel={marketingCopy.motionControls.pauseVideo}
    playLabel={marketingCopy.motionControls.playVideo}
    class="absolute right-3 bottom-3 z-[3]"
  />
</div>

<script>
  import { initializeHeroLoop } from "./hero-loop-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-hero-loop]")) {
    initializeHeroLoop(root);
  }
</script>
