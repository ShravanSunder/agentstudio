---
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import {
  railAnchorAttribute,
  railSurfaceTargetAttribute,
  railTargetEdgeAttribute,
  railTerminalTargetAttribute,
} from "@/chapters/chapter-dom-contract";
import { installCommandText, marketingCopy } from "@/marketing-copy";
import KitIcon from "@/recreation-kit/KitIcon.astro";

const terminalRailAttributes = {
  [railAnchorAttribute]: "final-cta",
  [railSurfaceTargetAttribute]: "final-cta",
  [railTargetEdgeAttribute]: "left",
  [railTerminalTargetAttribute]: "",
};
---

<section class="final-cta relative grid grid-cols-1 justify-items-center px-page-inline text-center" aria-labelledby="final-cta-title" data-finale-root data-finale-state="settled">
  <div class="finale-stage relative" aria-hidden="true">
    <div class="finale-plane finale-plane--rear-one" data-finale-rear-one></div>
    <div class="finale-plane finale-plane--rear-two" data-finale-rear-two></div>
    <div class="finale-plane finale-plane--front" data-finale-front>
      <svg viewBox="0 0 610 390" aria-hidden="true"><path d="M205 135 L275 187 L205 239" fill="none" stroke="#74c7ec" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"></path><path d="M325 241 L425 241" fill="none" stroke="#74c7ec" stroke-width="24" stroke-linecap="round"></path></svg>
    </div>
    <div class="finale-terminal" data-finale-terminal>
      <div class="finale-terminal__bar"><span>● ● ●</span></div>
      <span class="finale-terminal__prompt">&gt;_</span>
    </div>
    <img class="finale-app-logo" data-finale-logo src={appLogo.src} width="108" height="108" alt="" decoding="async" />
  </div>

  <h2 id="final-cta-title" class="m-0 font-display text-closing-display font-extrabold">{marketingCopy.productName}</h2>

  <div
    class="finale-split-pill floating-glass-material relative inline-flex max-w-full items-stretch overflow-visible rounded-full border"
    {...terminalRailAttributes}
    data-finale-split-pill
    data-install-command-root
    data-install-command={installCommandText}
    data-install-copied-label={marketingCopy.finalCallToAction.copiedInstall}
    data-install-feedback-ms="2000"
  >
    <a class="final-star-button relative z-[1] inline-flex items-center justify-center" data-final-star-button href={marketingCopy.githubUrl} target="_blank" rel="noopener noreferrer">
      <svg class="finale-star-icon" viewBox="0 0 24 24" aria-hidden="true"><path data-finale-star-outline d="M12 2.5 14.93 8.55 21.6 9.52 16.8 14.2 17.94 20.82 12 17.69 6.06 20.82 7.2 14.2 2.4 9.52 9.07 8.55Z"></path><path data-finale-star-fill d="M12 2.5 14.93 8.55 21.6 9.52 16.8 14.2 17.94 20.82 12 17.69 6.06 20.82 7.2 14.2 2.4 9.52 9.07 8.55Z"></path></svg>
      <span class="finale-label-full">{marketingCopy.finalCallToAction.starOnGitHub}</span>
      <span class="finale-label-short">{marketingCopy.finalCallToAction.starShort}</span>
    </a>
    <button type="button" class="finale-copy-button relative z-[1] inline-flex items-center justify-center" data-install-copy aria-label={marketingCopy.installation.copyButton}>
      <KitIcon name="copy" class="h-4 w-4" />
      <span class="finale-label-full" data-install-copy-feedback>{marketingCopy.finalCallToAction.copyInstall}</span>
      <span class="finale-label-short" data-install-copy-feedback>{marketingCopy.finalCallToAction.copyShort}</span>
    </button>
    <span class="sr-only" data-install-status aria-live="polite"></span>
    <code data-install-code hidden>{installCommandText}</code>
    <svg class="finale-border-trace pointer-events-none absolute inset-0 z-[2] h-full w-full overflow-visible" aria-hidden="true"><path data-finale-border-trace></path></svg>
  </div>

  <p class="m-0 text-[14px] text-ink-faint">{marketingCopy.installation.systemRequirement}</p>
</section>

<script>
  import { initializeInstallCommand } from "@/install-command/install-command-controller";
  import { initializeFinaleBookend } from "@/finale-bookend/finale-bookend-playback";

  const root = document.querySelector<HTMLElement>("[data-finale-root]");
  const pill = root?.querySelector<HTMLElement>("[data-finale-split-pill]");
  if (root !== null && root !== undefined && pill !== null && pill !== undefined) {
    initializeInstallCommand(pill);
    initializeFinaleBookend(root);
  }
</script>

<style>
  .final-cta { isolation: isolate; gap: 13px; padding-top: 26px; padding-bottom: 26px; }
  .finale-stage { width: 238px; height: 144px; pointer-events: none; }
  .finale-plane, .finale-terminal { position: absolute; left: 19px; top: 13px; width: 200px; height: 126px; border-radius: 17px; box-shadow: 0 9px 22px #0005; transform-origin: 50% 55%; }
  .finale-plane--rear-one { z-index: 1; border: 2px solid #ef9f76; background: #191b1f; transform: translate(-24px, -1px) rotate(-12deg); }
  .finale-plane--rear-two { z-index: 2; border: 2px solid #ef9f76; background: #191b1f; transform: translate(-11px, -4px) rotate(7deg); }
  .finale-plane--front { z-index: 3; display: grid; place-items: center; border: 2px solid #89b4fa; background: #1e1e2e; transform: rotate(0deg); }
  .finale-plane--front svg { display: block; width: 100%; height: 100%; }
  .finale-terminal { z-index: 4; overflow: hidden; border: 1px solid rgb(137 180 250 / 38%); background: #282c34; box-shadow: 0 16px 34px #0004; }
  .finale-terminal__bar { height: 22px; border-bottom: 1px solid rgb(255 255 255 / 10%); background: #30343c; text-align: left; }
  .finale-terminal__bar span { margin-left: 11px; color: #ef9f76; font-size: 10px; letter-spacing: 2px; }
  .finale-terminal__prompt { position: absolute; left: 18px; top: 45px; color: #74c7ec; font: 23px var(--font-mono-product); }
  .finale-app-logo { position: absolute; z-index: 5; top: 14px; left: 65px; width: 108px; height: 108px; object-fit: contain; }
  .final-cta[data-finale-state="ready"] .finale-app-logo, .final-cta[data-finale-state="playing"] .finale-app-logo { opacity: 0; }
  .final-cta[data-finale-state="ready"] .finale-star-icon, .final-cta[data-finale-state="ready"] .finale-border-trace { opacity: 0; }
  .final-cta[data-finale-state="settled"] .finale-plane, .final-cta[data-finale-state="settled"] .finale-terminal { opacity: 0; }
  .final-cta[data-finale-state="settled"] .finale-border-trace { opacity: 0.6; }
  .finale-split-pill { width: max-content; margin-top: 19px; white-space: nowrap; }
  .final-cta > p { margin-top: 22px; }
  .final-star-button, .finale-copy-button { min-height: 48px; gap: 9px; padding: 0 22px; font-size: 14px; font-weight: 650; white-space: nowrap; }
  .final-star-button { min-width: 190px; border-radius: 999px 0 0 999px; background: var(--color-primary); color: var(--color-canvas); }
  .final-star-button:hover { background: color-mix(in srgb, var(--color-primary) 86%, white); }
  .finale-copy-button { min-width: 190px; cursor: pointer; border-left: 1px solid rgb(255 255 255 / 16%); border-radius: 0 999px 999px 0; color: var(--color-ink-secondary); }
  .finale-copy-button:hover { background: rgb(255 255 255 / 7%); }
  .finale-star-icon { width: 18px; height: 18px; flex: none; }
  .finale-star-icon path { stroke: currentColor; stroke-width: 1.8; stroke-linejoin: round; }
  .finale-star-icon [data-finale-star-outline] { fill: none; }
  .finale-star-icon [data-finale-star-fill] { fill: currentColor; }
  .finale-label-short { display: none; }
  .finale-border-trace path { fill: none; stroke: #e2efff; stroke-width: 2.5px; }
  .final-cta[data-short-labels] .finale-label-full { display: none; }
  .final-cta[data-short-labels] .finale-label-short { display: inline; }
  .final-cta[data-short-labels] .final-star-button, .final-cta[data-short-labels] .finale-copy-button { min-width: 0; }
  @media (width < 38.75rem) {
    .final-cta { gap: 9px; padding-top: 17px; padding-bottom: 20px; }
    .finale-split-pill { margin-top: 16px; }
    .final-cta > p { margin-top: 25px; }
    .finale-stage { width: 190px; height: 105px; }
    .finale-plane, .finale-terminal { top: 8px; left: 20px; width: 150px; height: 95px; border-radius: 13px; }
    .finale-plane--rear-one { transform: translate(-18px, -1px) rotate(-12deg); }
    .finale-plane--rear-two { transform: translate(-8px, -3px) rotate(7deg); }
    .finale-terminal__bar { height: 18px; }
    .finale-terminal__bar span { font-size: 8px; }
    .finale-terminal__prompt { top: 33px; left: 14px; font-size: 18px; }
    .finale-app-logo { top: 6px; left: 55px; width: 90px; height: 90px; }
    .final-star-button, .finale-copy-button { min-height: 45px; padding: 0 16px; }
  }
</style>
