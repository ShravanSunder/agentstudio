---
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import { marketingCopy } from "@/marketing-copy";
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <img src={appLogo.src} width="88" height="88" alt="" />
  <h2 id="final-cta-title">{marketingCopy.productName}</h2>
  <p>{marketingCopy.finalCallToAction.description}</p>
  <p class="final-cta__traits">{marketingCopy.finalCallToAction.traits}</p>
</section>
