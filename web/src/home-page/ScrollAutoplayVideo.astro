---
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends Omit<HTMLAttributes<"video">, "class" | "poster" | "src"> {
  readonly accessibilityLabel: string;
  readonly class?: string;
  readonly fallbackText?: string;
  readonly poster?: ImageMetadata | string;
  readonly replayDelayMs?: number;
  readonly source: string;
  readonly sourceType?: string;
  readonly startProgress?: number;
  readonly stopProgress?: number;
}

const {
  accessibilityLabel,
  class: className,
  fallbackText = "This browser cannot play this video.",
  poster,
  replayDelayMs = 3000,
  source,
  sourceType = "video/mp4",
  startProgress = 0.9,
  stopProgress = 0.85,
  ...videoAttributes
} = Astro.props;

const posterUrl = typeof poster === "string" ? poster : poster?.src;
---

<video
  {...videoAttributes}
  controls
  muted
  playsinline
  preload="metadata"
  poster={posterUrl}
  aria-label={accessibilityLabel}
  class={className}
  data-scroll-autoplay-video
  data-scroll-autoplay-start-progress={startProgress}
  data-scroll-autoplay-stop-progress={stopProgress}
  data-scroll-autoplay-replay-delay-ms={replayDelayMs}
>
  <source src={source} type={sourceType} />
  <span>{fallbackText}</span>
</video>
