---
import { installCommandText, marketingCopy } from "@/marketing-copy";
---

<div
  class="install-command relative grid min-w-[min(100%,470px)] grid-cols-[minmax(0,1fr)_auto] items-stretch overflow-clip rounded-control border border-primary bg-rear-plane-one max-phone:min-w-full max-phone:grid-cols-[minmax(0,1fr)]"
  data-install-command-root
  data-install-command={installCommandText}
>
  <code
    class="grid gap-[4px] overflow-x-auto px-[17px] py-[15px] font-mono-product text-[14px] leading-normal text-ink whitespace-nowrap max-phone:overflow-x-visible max-phone:text-[12px]"
  >
    {
      marketingCopy.installation.commands.map((command) => (
        <span class="text-ink"><span class="text-glyph" aria-hidden="true">$ </span>{command}</span>
      ))
    }
  </code>
  <button
    type="button"
    class="inline-grid min-h-[48px] cursor-pointer place-items-center bg-primary px-[18px] [font-weight:750] text-[#0e1a2a] max-phone:min-h-[44px]"
    data-install-copy
    aria-label={marketingCopy.installation.copyButton}
  >
    {marketingCopy.installation.copyButtonVisible}
  </button>
  <span
    class="absolute top-[calc(100%+7px)] left-0 text-[12px] text-glyph"
    data-install-status
    aria-live="polite"
  ></span>
</div>

<script>
  import { initializeInstallCommand } from "@/install-command/install-command-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-install-command-root]")) {
    initializeInstallCommand(root);
  }
</script>
