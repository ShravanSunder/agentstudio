---
import { installCommandText, marketingCopy } from "@/marketing-copy";
---

<!--
  One command box: the commands, then a quiet trailing Copy control behind a
  hairline divider, at every width. The status line sits below the box.
-->
<div
  class="install-command relative flex min-w-[min(100%,470px)] items-stretch rounded-xl border border-line bg-active-surface max-phone:min-w-full"
  data-install-command-root
  data-install-command={installCommandText}
>
  <code
    class="grid min-w-0 flex-1 gap-1 overflow-x-auto px-4.25 py-3.75 font-mono-product text-[14px] leading-normal whitespace-nowrap text-ink max-phone:px-3 max-phone:py-3 max-phone:text-[11px]"
  >
    {
      marketingCopy.installation.commands.map((command) => (
        <span class="text-ink"><span class="text-glyph" aria-hidden="true">$ </span>{command}</span>
      ))
    }
  </code>
  <button
    type="button"
    class="flex-none cursor-pointer rounded-r-xl border-l border-line px-4.5 font-mono-product text-[12px] font-semibold tracking-[0.14em] text-ink-faint uppercase transition-colors duration-150 ease-out hover:bg-[rgb(255_255_255/4%)] hover:text-ink motion-reduce:transition-none max-phone:px-3 max-phone:text-[11px]"
    data-install-copy
    aria-label={marketingCopy.installation.copyButton}
  >
    {marketingCopy.installation.copyButtonVisible}
  </button>
  <span
    class="absolute top-[calc(100%+7px)] left-0 text-[12px] text-glyph"
    data-install-status
    aria-live="polite"
  ></span>
</div>

<script>
  import { initializeInstallCommand } from "@/install-command/install-command-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-install-command-root]")) {
    initializeInstallCommand(root);
  }
</script>
