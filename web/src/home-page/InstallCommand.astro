---
import { installCommandText, marketingCopy } from "@/marketing-copy";
import KitIcon from "@/recreation-kit/KitIcon.astro";
---

<!--
  One command box: the commands, then a quiet trailing Copy control behind a
  hairline divider, at every width. The status line sits below the box.
-->
<div
  class="install-command relative flex min-w-[min(100%,470px)] items-stretch rounded-xl border border-line bg-active-surface max-phone:min-w-full"
  data-install-command-root
  data-install-command={installCommandText}
>
  <code
    class="install-command__code grid min-w-0 flex-1 gap-1 overflow-x-auto px-4.25 py-3.75 font-mono-product leading-normal whitespace-nowrap text-ink max-phone:px-3 max-phone:py-3"
    data-install-code
  >
    {
      marketingCopy.installation.commands.map((command) => (
    <span class="install-command__line relative text-ink"><span class="text-glyph" aria-hidden="true">$ </span>{command}<span class="install-command__decode absolute inset-0 opacity-0" data-install-decode-line aria-hidden="true"></span></span>
      ))
    }
  </code>
  <button
    type="button"
    class="install-command__copy flex-none cursor-pointer rounded-r-xl border-l border-line px-4.5 font-mono-product text-[12px] font-semibold tracking-[0.14em] text-ink-faint uppercase transition-colors duration-150 ease-out hover:bg-[rgb(255_255_255/4%)] hover:text-ink motion-reduce:transition-none"
    data-install-copy
    aria-label={marketingCopy.installation.copyButton}
  >
    <span data-install-copy-label>{marketingCopy.installation.copyButtonVisible}</span>
    <KitIcon name="copy" class="install-command__copy-icon h-4 w-4" />
  </button>
  <span
    class="absolute top-[calc(100%+7px)] left-0 text-[12px] text-glyph"
    data-install-status
    aria-live="polite"
  ></span>
</div>

<style>
  .install-command__decode { background: var(--color-active-surface); pointer-events: none; }
  .install-command__code {
    font-size: clamp(9px, 2.45vw, 14px);
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    scrollbar-width: none;
  }
  .install-command__code::-webkit-scrollbar { display: none; }
  .install-command[data-install-overflow] .install-command__code {
    mask-image: linear-gradient(to right, black calc(100% - 20px), transparent);
  }
  .install-command__copy-icon { display: none; }
  .install-command[data-compact-copy] .install-command__copy { width: 36px; padding: 0; }
  .install-command[data-compact-copy] [data-install-copy-label] { display: none; }
  .install-command[data-compact-copy] .install-command__copy-icon { display: block; margin: auto; }
</style>

<script>
  import { initializeInstallCommand } from "@/install-command/install-command-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-install-command-root]")) {
    initializeInstallCommand(root);
  }
</script>
