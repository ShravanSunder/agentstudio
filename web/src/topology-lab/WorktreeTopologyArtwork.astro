---
type TopologyNodeKind = "checkpoint" | "current" | "fork" | "merge" | "ordinary" | "pull-request";
type TopologyAccent = "cyan" | "main" | "peach";

interface TopologyNode {
  readonly accent?: TopologyAccent;
  readonly kind: TopologyNodeKind;
  readonly lane: 0 | 1 | 2 | 3 | 4;
  readonly row: number;
}

interface WorktreeRoute {
  readonly arrivalRow: number;
  readonly className: string;
  readonly forkRow: number;
  readonly lane: 1 | 2 | 3 | 4;
  readonly mergeApproachRow: number;
  readonly mergeRow: number;
}

interface RouteSegment {
  readonly d: string;
  readonly endX: number;
  readonly endY: number;
  readonly endRow: number;
  readonly kind: "fork" | "lane" | "merge";
  readonly startX: number;
  readonly startY: number;
  readonly startRow: number;
}

const firstRowY = 100;
const rowHeight = 84;
const lanePositions = [240, 300, 360, 420, 480] as const;
const finalRow = 26;
const leadingEdgeBands = [
  { end: 1 / 6, opacity: 1, start: 0 },
  { end: 2 / 6, opacity: 0.78, start: 1 / 6 },
  { end: 3 / 6, opacity: 0.56, start: 2 / 6 },
  { end: 4 / 6, opacity: 0.34, start: 3 / 6 },
  { end: 5 / 6, opacity: 0.16, start: 4 / 6 },
  { end: 1, opacity: 0.04, start: 5 / 6 },
] as const;

function rowY(row: number): number {
  return firstRowY + row * rowHeight;
}

function laneAccent(lane: TopologyNode["lane"]): TopologyAccent {
  if (lane === 0) {
    return "main";
  }
  return lane === 1 || lane === 3 ? "peach" : "cyan";
}

function routeSegments(route: WorktreeRoute): readonly RouteSegment[] {
  const mainLaneX = lanePositions[0];
  const worktreeLaneX = lanePositions[route.lane];
  const forkY = rowY(route.forkRow);
  const arrivalY = rowY(route.arrivalRow);
  const forkControlX = mainLaneX + (worktreeLaneX - mainLaneX) / 2;
  const mergeApproachY = rowY(route.mergeApproachRow);
  const mergeY = rowY(route.mergeRow);
  const mergeControlX = mainLaneX + (worktreeLaneX - mainLaneX) / 2;
  return [
    {
      d: `M ${mainLaneX} ${forkY} C ${forkControlX} ${forkY} ${worktreeLaneX} ${arrivalY - rowHeight / 2} ${worktreeLaneX} ${arrivalY}`,
      endX: worktreeLaneX,
      endY: arrivalY,
      endRow: route.arrivalRow,
      kind: "fork",
      startX: mainLaneX,
      startY: forkY,
      startRow: route.forkRow,
    },
    {
      d: `M ${worktreeLaneX} ${arrivalY} L ${worktreeLaneX} ${mergeApproachY}`,
      endX: worktreeLaneX,
      endY: mergeApproachY,
      endRow: route.mergeApproachRow,
      kind: "lane",
      startX: worktreeLaneX,
      startY: arrivalY,
      startRow: route.arrivalRow,
    },
    {
      d: `M ${worktreeLaneX} ${mergeApproachY} C ${worktreeLaneX} ${mergeApproachY + rowHeight / 2} ${mergeControlX} ${mergeY} ${mainLaneX} ${mergeY}`,
      endX: mainLaneX,
      endY: mergeY,
      endRow: route.mergeRow,
      kind: "merge",
      startX: worktreeLaneX,
      startY: mergeApproachY,
      startRow: route.mergeApproachRow,
    },
  ];
}

const routes = [
  {
    arrivalRow: 3,
    className: "worktree-a",
    forkRow: 2,
    lane: 1,
    mergeApproachRow: 16,
    mergeRow: 17,
  },
  {
    arrivalRow: 6,
    className: "worktree-b",
    forkRow: 5,
    lane: 2,
    mergeApproachRow: 21,
    mergeRow: 22,
  },
  {
    arrivalRow: 9,
    className: "worktree-c",
    forkRow: 8,
    lane: 3,
    mergeApproachRow: 19,
    mergeRow: 20,
  },
  {
    arrivalRow: 13,
    className: "worktree-d",
    forkRow: 12,
    lane: 4,
    mergeApproachRow: 24,
    mergeRow: 25,
  },
] satisfies readonly WorktreeRoute[];

const nodes = [
  { kind: "current", lane: 0, row: 0 },
  { kind: "ordinary", lane: 0, row: 1 },
  { accent: "peach", kind: "fork", lane: 0, row: 2 },
  { kind: "ordinary", lane: 1, row: 3 },
  { kind: "ordinary", lane: 0, row: 4 },
  { accent: "cyan", kind: "fork", lane: 0, row: 5 },
  { kind: "ordinary", lane: 2, row: 6 },
  { kind: "pull-request", lane: 1, row: 7 },
  { accent: "peach", kind: "fork", lane: 0, row: 8 },
  { kind: "ordinary", lane: 3, row: 9 },
  { kind: "pull-request", lane: 2, row: 10 },
  { kind: "checkpoint", lane: 0, row: 11 },
  { accent: "cyan", kind: "fork", lane: 0, row: 12 },
  { kind: "ordinary", lane: 4, row: 13 },
  { kind: "checkpoint", lane: 1, row: 14 },
  { kind: "pull-request", lane: 3, row: 15 },
  { kind: "ordinary", lane: 0, row: 16 },
  { kind: "merge", lane: 0, row: 17 },
  { kind: "pull-request", lane: 4, row: 18 },
  { kind: "checkpoint", lane: 2, row: 19 },
  { kind: "merge", lane: 0, row: 20 },
  { kind: "ordinary", lane: 0, row: 21 },
  { kind: "merge", lane: 0, row: 22 },
  { kind: "checkpoint", lane: 4, row: 23 },
  { kind: "ordinary", lane: 0, row: 24 },
  { kind: "merge", lane: 0, row: 25 },
  { kind: "current", lane: 0, row: 26 },
] satisfies readonly TopologyNode[];

const svgHeight = rowY(finalRow) + 100;
---

<svg
  class="block h-full w-full"
  data-topology-artwork
  viewBox={`0 0 540 ${svgHeight}`}
  width="540"
  height={svgHeight}
  preserveAspectRatio="none"
  role="img"
  aria-labelledby="topology-artwork-title topology-artwork-description"
>
  <title id="topology-artwork-title">Row-based five-lane worktree topology study</title>
  <desc id="topology-artwork-description">
    A repository activity topology arranged on fixed event rows and five worktree lanes. Four
    worktrees merge back into the mainline.
  </desc>

  <g class="topology-primary">
    {
      leadingEdgeBands.map((band) => (
        <path
          class="topology-leading-edge topology-reveal-path"
          data-topology-lead-start={band.start}
          data-topology-lead-end={band.end}
          data-topology-path-role="leading-band"
          data-topology-path-start="0"
          data-topology-path-end="1"
          d={`M ${lanePositions[0]} ${rowY(0)} L ${lanePositions[0]} ${rowY(finalRow)}`}
          style={`opacity: ${band.opacity}`}
        />
      ))
    }
    <path
      class="topology-reveal-path"
      data-topology-path-role="core"
      data-topology-path-start="0"
      data-topology-path-end="1"
      d={`M ${lanePositions[0]} ${rowY(0)} L ${lanePositions[0]} ${rowY(finalRow)}`}
    />
  </g>

  {
    routes.map((route) => {
      const segments = routeSegments(route);

      return (
        <g class:list={["topology-worktree", route.className]}>
          <g class="topology-clearances">
            {segments.map((segment) => (
              <path
                class="topology-clearance topology-reveal-path"
                data-topology-path-role="clearance"
                data-topology-path-start={segment.startRow / finalRow}
                data-topology-path-end={segment.endRow / finalRow}
                data-topology-segment-kind={segment.kind}
                data-topology-segment-start-x={segment.startX}
                data-topology-segment-start-y={segment.startY}
                data-topology-segment-end-x={segment.endX}
                data-topology-segment-end-y={segment.endY}
                d={segment.d}
              />
            ))}
          </g>
          <g class="topology-leading-edges">
            {segments.map((segment) =>
              leadingEdgeBands.map((band) => (
                <path
                  class="topology-leading-edge topology-reveal-path"
                  data-topology-lead-start={band.start}
                  data-topology-lead-end={band.end}
                  data-topology-path-role="leading-band"
                  data-topology-path-start={segment.startRow / finalRow}
                  data-topology-path-end={segment.endRow / finalRow}
                  data-topology-segment-kind={segment.kind}
                  data-topology-segment-start-x={segment.startX}
                  data-topology-segment-start-y={segment.startY}
                  data-topology-segment-end-x={segment.endX}
                  data-topology-segment-end-y={segment.endY}
                  d={segment.d}
                  style={`opacity: ${band.opacity}`}
                />
              )),
            )}
          </g>
          <g class="topology-lines">
            {segments.map((segment) => (
              <path
                class="topology-line topology-reveal-path"
                data-topology-path-role="core"
                data-topology-path-start={segment.startRow / finalRow}
                data-topology-path-end={segment.endRow / finalRow}
                data-topology-segment-kind={segment.kind}
                data-topology-segment-start-x={segment.startX}
                data-topology-segment-start-y={segment.startY}
                data-topology-segment-end-x={segment.endX}
                data-topology-segment-end-y={segment.endY}
                d={segment.d}
              />
            ))}
          </g>
        </g>
      );
    })
  }

  <g class="topology-nodes">
    {
      nodes.map((node) => {
        const x = lanePositions[node.lane];
        const y = rowY(node.row);
        const accent = node.accent ?? laneAccent(node.lane);
        const nodeProgress = node.row / finalRow;

        if (node.kind === "merge") {
          return (
            <g
              class={`node-merge accent-${accent}`}
              data-topology-node-lane={node.lane}
              data-topology-node-progress={nodeProgress}
              data-topology-node-row={node.row}
              transform={`translate(${x} ${y})`}
            >
              <g data-topology-node-shape>
                <circle cx="0" cy="0" r="8" />
                <path d="M -3 -1 L 0 2 L 3 -1" />
              </g>
            </g>
          );
        }

        if (node.kind === "current") {
          return (
            <g
              class={`node-terminal-group accent-${accent}`}
              data-topology-node-lane={node.lane}
              data-topology-node-progress={nodeProgress}
              data-topology-node-row={node.row}
              transform={`translate(${x} ${y})`}
            >
              <g data-topology-node-shape>
                <circle class="node-terminal-halo" cx="0" cy="0" r="7" />
                <circle class="node-terminal" cx="0" cy="0" r="7" />
              </g>
            </g>
          );
        }

        return (
          <g
            class={`accent-${accent}`}
            data-topology-node-lane={node.lane}
            data-topology-node-progress={nodeProgress}
            data-topology-node-row={node.row}
            transform={`translate(${x} ${y})`}
          >
            <g data-topology-node-shape>
              <circle class="node-filled" cx="0" cy="0" r="4" />
            </g>
          </g>
        );
      })
    }
  </g>
</svg>

<script>
  import { initializeTopologyScrollReveal } from "./topology-scroll-reveal";

  const topologyArtwork = document.querySelector<SVGSVGElement>("[data-topology-artwork]");
  if (topologyArtwork !== null) {
    initializeTopologyScrollReveal(topologyArtwork);
  }
</script>

<style>
  path,
  circle {
    vector-effect: non-scaling-stroke;
  }

  .topology-primary path,
  .topology-worktree path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .topology-primary path {
    stroke: rgb(137 180 250 / 62%);
    stroke-width: 1.5px;
  }

  .topology-reveal-path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .topology-primary .topology-leading-edge,
  .topology-worktree .topology-leading-edge {
    stroke-linecap: butt;
  }

  [data-topology-node-progress] {
    opacity: 0;
  }

  [data-topology-at-start] [data-topology-node-progress="0"] {
    animation: topology-start-node-breathe 3.2s ease-in-out infinite;
  }

  [data-topology-at-end] .node-terminal-halo {
    animation: topology-terminal-node-halo 3.2s ease-out infinite;
  }

  .topology-worktree .topology-clearance {
    stroke: #2e3036;
    stroke-width: 5px;
  }

  .worktree-a .topology-line,
  .worktree-a .topology-leading-edge,
  .worktree-c .topology-line,
  .worktree-c .topology-leading-edge {
    stroke: rgb(239 159 118 / 42%);
    stroke-width: 1px;
  }

  .worktree-b .topology-line,
  .worktree-b .topology-leading-edge,
  .worktree-d .topology-line,
  .worktree-d .topology-leading-edge {
    stroke: rgb(116 199 236 / 44%);
    stroke-width: 1px;
  }

  .topology-nodes circle {
    fill: #2e3036;
    stroke: rgb(255 255 255 / 24%);
    stroke-width: 1px;
  }

  .topology-nodes .accent-main {
    --node-accent: #89b4fa;
    stroke: var(--node-accent);
  }

  .topology-nodes .accent-peach {
    --node-accent: #ef9f76;
    stroke: var(--node-accent);
  }

  .topology-nodes .accent-cyan {
    --node-accent: #74c7ec;
    stroke: var(--node-accent);
  }

  .topology-nodes .node-filled {
    fill: var(--node-accent);
    stroke: var(--node-accent);
  }

  .topology-nodes .node-terminal,
  .topology-nodes .node-merge circle {
    fill: #2e3036;
    stroke: var(--node-accent);
    stroke-width: 1.5px;
  }

  .topology-nodes .node-terminal {
    fill: var(--node-accent);
  }

  .topology-nodes .node-terminal-halo {
    fill: none;
    stroke: var(--node-accent);
    stroke-width: 2px;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .topology-nodes .node-merge path {
    fill: none;
    stroke: var(--node-accent);
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @keyframes topology-start-node-breathe {
    0%,
    100% {
      opacity: 0.2;
    }

    50% {
      opacity: 0.8;
    }
  }

  @keyframes topology-terminal-node-halo {
    0% {
      opacity: 0.5;
      transform: scale(1);
    }

    70%,
    100% {
      opacity: 0;
      transform: scale(2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-topology-node-progress="0"] {
      animation: none;
    }

    .node-terminal-halo {
      animation: none;
      opacity: 0;
    }
  }
</style>
