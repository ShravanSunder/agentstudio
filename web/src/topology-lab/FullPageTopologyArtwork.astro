---
type RouteAccent = "cyan" | "peach";
type RouteEndKind = "merge" | "open";
type TopologyVariant = "compact" | "expanded" | "standard";

interface Props {
  readonly mainlineAnchorSelector?: string;
  readonly portalFrameSelector?: string;
  readonly portalSurfaceSelector?: string;
}

interface AuthoredWorktreeBase {
  readonly accent: RouteAccent;
  readonly endSlot: number;
  readonly forkSlot: number;
  readonly id: string;
  readonly nodeSlots: readonly number[];
  readonly variants: readonly TopologyVariant[];
}

type OptionalPageEndAnchor =
  | { readonly endPageOffset?: never; readonly endPageRow?: never }
  | { readonly endPageOffset: number; readonly endPageRow?: never }
  | { readonly endPageOffset?: never; readonly endPageRow: number };

type LocalRightWorktree = AuthoredWorktreeBase &
  OptionalPageEndAnchor & {
    readonly endGlassIndex?: never;
    readonly endKind: RouteEndKind;
    readonly forkGlassIndex?: never;
    readonly forkPageRow?: number;
    readonly placement: "local-right";
  };

type CrossGlassLeftWorktree =
  | (AuthoredWorktreeBase & {
      readonly endGlassIndex: number;
      readonly endKind: "merge";
      readonly endPageOffset?: never;
      readonly endPageRow?: never;
      readonly forkGlassIndex: number;
      readonly forkPageRow?: never;
      readonly placement: "cross-glass-left";
    })
  | (AuthoredWorktreeBase &
      OptionalPageEndAnchor & {
        readonly endGlassIndex?: never;
        readonly endKind: "open";
        readonly forkGlassIndex: number;
        readonly forkPageRow?: never;
        readonly placement: "cross-glass-left";
      });

type AuthoredWorktree = CrossGlassLeftWorktree | LocalRightWorktree;

const { mainlineAnchorSelector, portalFrameSelector, portalSurfaceSelector } = Astro.props;
const worktrees: readonly AuthoredWorktree[] = [
  {
    accent: "peach",
    endKind: "merge",
    endPageRow: 15,
    endSlot: 5,
    forkPageRow: 2,
    forkSlot: 0,
    id: "worktree-a",
    nodeSlots: [],
    placement: "local-right",
    variants: ["compact", "standard", "expanded"],
  },
  {
    accent: "cyan",
    endKind: "merge",
    endPageRow: 16,
    endSlot: 6,
    forkPageRow: 4,
    forkSlot: 1,
    id: "worktree-b",
    nodeSlots: [],
    placement: "local-right",
    variants: ["standard", "expanded"],
  },
  {
    accent: "peach",
    endGlassIndex: 3,
    endKind: "merge",
    endSlot: 20,
    forkGlassIndex: 0,
    forkSlot: 0,
    id: "worktree-c",
    nodeSlots: [],
    placement: "cross-glass-left",
    variants: ["standard", "expanded"],
  },
  {
    accent: "cyan",
    endKind: "open",
    endSlot: 16,
    endPageOffset: 4,
    forkGlassIndex: 1,
    forkSlot: 6,
    id: "worktree-d",
    nodeSlots: [],
    placement: "cross-glass-left",
    variants: ["expanded"],
  },
  {
    accent: "peach",
    endKind: "merge",
    endPageOffset: 3,
    endSlot: 18,
    forkPageRow: 17,
    forkSlot: 7,
    id: "worktree-e",
    nodeSlots: [],
    placement: "local-right",
    variants: ["expanded"],
  },
  {
    accent: "cyan",
    endKind: "open",
    endPageOffset: 2,
    endSlot: 19,
    forkPageRow: 18,
    forkSlot: 8,
    id: "worktree-f",
    nodeSlots: [],
    placement: "local-right",
    variants: ["expanded"],
  },
  {
    accent: "peach",
    endKind: "open",
    endPageOffset: 1,
    endSlot: 19,
    forkGlassIndex: 2,
    forkSlot: 14,
    id: "worktree-g",
    nodeSlots: [],
    placement: "cross-glass-left",
    variants: ["expanded"],
  },
] as const;

---

<svg
  class="block h-full w-full opacity-90"
  data-full-page-topology
  data-mainline-anchor-selector={mainlineAnchorSelector}
  data-portal-frame-selector={portalFrameSelector}
  data-portal-surface-selector={portalSurfaceSelector}
  viewBox="0 0 1000 5200"
  preserveAspectRatio="none"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="topology-vertical-reveal-gradient" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="white" stop-opacity="1" />
      <stop offset="1" stop-color="white" stop-opacity="0" />
    </linearGradient>
    <mask id="topology-vertical-reveal-mask" maskUnits="userSpaceOnUse">
      <rect data-topology-reveal-solid x="0" y="0" width="1000" height="0" fill="white" />
      <rect
        data-topology-reveal-fade
        x="0"
        y="0"
        width="1000"
        height="0"
        fill="url(#topology-vertical-reveal-gradient)"
      />
    </mask>
  </defs>
  <g data-topology-reveal-layer mask="url(#topology-vertical-reveal-mask)">
  <g class="topology-primary">
    <path
      class="topology-mainline topology-line topology-reveal-path"
      data-mainline
      data-topology-path-role="core"
      data-topology-path-start="0"
      data-topology-path-end="1"
    />
  </g>

  {
    worktrees.map((worktree) => (
      <g
        class={`topology-route accent-${worktree.accent}`}
        data-topology-route-group
        data-route-id={worktree.id}
        data-route-accent={worktree.accent}
        data-route-placement={worktree.placement}
        data-topology-variants={worktree.variants.join(" ")}
        data-fork-slot={worktree.forkSlot}
        data-fork-glass-index={worktree.forkGlassIndex}
        data-fork-page-row={worktree.forkPageRow}
        data-end-slot={worktree.endSlot}
        data-end-glass-index={worktree.endGlassIndex}
        data-end-page-offset={worktree.endPageOffset}
        data-end-page-row={worktree.endPageRow}
        data-end-kind={worktree.endKind}
      >
        <path
          class="topology-clearance topology-reveal-path"
          data-route
          data-topology-path-role="clearance"
          data-topology-path-start="0"
          data-topology-path-end="1"
        />
        <path
          class="topology-line topology-reveal-path"
          data-route
          data-topology-path-role="core"
          data-topology-path-start="0"
          data-topology-path-end="1"
        />
        <circle
          class="accent-main"
          data-node
          data-node-position="fork"
          data-topology-route-node
          data-topology-node-progress="1"
          r="4"
        />
        {worktree.nodeSlots.map((slot) => (
          <circle
            data-node
            data-node-position="target"
            data-node-slot={slot}
            data-topology-node-progress="1"
            r="4"
          />
        ))}
        <circle
          class={worktree.endKind === "merge" ? "accent-main" : undefined}
          data-node
          data-node-position="end"
          data-topology-route-node
          data-topology-node-progress="1"
          r="4"
        />
      </g>
    ))
  }

  <g
    class="node-terminal-group accent-main"
    data-node
    data-mainline-node="start"
    data-topology-node-progress="0"
  >
    <circle class="node-terminal-halo" r="7" />
    <circle class="node-terminal" r="7" />
  </g>
  <g
    class="node-terminal-group accent-main"
    data-node
    data-mainline-node="end"
    data-topology-node-progress="1"
  >
    <circle class="node-terminal-halo" r="7" />
    <circle class="node-terminal" r="7" />
  </g>
  {
    Array.from({ length: 64 }, (_, index) => (
      <circle
        class="accent-main"
        data-node
        data-mainline-fill-index={index}
        data-topology-node-progress="1"
        r="4"
      />
    ))
  }
  </g>
</svg>

<script>
  import { layoutFullPageTopology } from "./full-page-topology-layout";
  import { initializeTopologyScrollReveal } from "./topology-scroll-reveal";

  const artwork = document.querySelector<SVGSVGElement>("[data-full-page-topology]");
  if (artwork !== null) {
    initializeTopologyScrollReveal(artwork, layoutFullPageTopology);
  }
</script>

<style>
  path,
  circle {
    vector-effect: non-scaling-stroke;
  }

  .topology-mainline,
  .topology-route > path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .topology-mainline {
    stroke: rgb(137 180 250 / 46%);
    stroke-width: 1.5px;
  }

  .topology-route > path {
    stroke-width: 1px;
  }

  .topology-route > .topology-clearance {
    stroke: var(--color-canvas);
    stroke-width: 5px;
  }

  .topology-reveal-path {
    stroke-dasharray: none;
    stroke-dashoffset: 0;
  }

  [data-topology-node-progress] {
    opacity: 0;
  }

  [data-topology-at-start] [data-topology-node-progress="0"] .node-terminal-halo,
  [data-topology-at-end] [data-topology-node-progress="1"] .node-terminal-halo {
    animation: topology-terminal-node-halo 3.2s ease-out infinite;
  }

  [data-topology-current-node]:not(.node-terminal-group) {
    animation: topology-current-node-pulse 2.6s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  .accent-peach {
    color: #ef9f76;
  }

  .accent-cyan {
    color: #74c7ec;
  }

  .accent-main {
    color: #89b4fa;
  }

  .accent-peach > path {
    stroke: rgb(239 159 118 / 34%);
  }

  .accent-cyan > path {
    stroke: rgb(116 199 236 / 36%);
  }

  [data-node] {
    fill: currentColor;
    stroke: currentColor;
  }

  .node-terminal {
    fill: #89b4fa;
    stroke: #89b4fa;
  }

  .node-terminal-halo {
    fill: none;
    stroke: currentColor;
    stroke-width: 2px;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  @keyframes topology-terminal-node-halo {
    0% {
      opacity: 0.72;
      transform: scale(1);
    }

    70%,
    100% {
      opacity: 0;
      transform: scale(2.35);
    }
  }

  @keyframes topology-current-node-pulse {
    0%,
    100% {
      filter: brightness(1) drop-shadow(0 0 0 currentColor);
      stroke-width: 1px;
      transform: scale(1);
    }

    45%,
    62% {
      filter: brightness(1.1) drop-shadow(0 0 4px currentColor);
      stroke-width: 1px;
      transform: scale(1.2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-topology-current-node] {
      animation: none;
    }

    .node-terminal-halo {
      animation: none;
      opacity: 0;
    }
  }
</style>
