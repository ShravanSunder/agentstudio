---
import {
  heroIconCursorAttribute,
  heroIconFrontAttribute,
  heroIconRearAttribute,
  heroIconStackAttribute,
} from "./hero-intro-dom-contract";
---

<div class="hero-icon-stack" {...{ [heroIconStackAttribute]: "" }} aria-hidden="true">
  <div class="hero-icon-plane hero-icon-plane--rear-one" {...{ [heroIconRearAttribute]: "one" }}></div>
  <div class="hero-icon-plane hero-icon-plane--rear-two" {...{ [heroIconRearAttribute]: "two" }}></div>
  <div class="hero-icon-plane hero-icon-plane--front" {...{ [heroIconFrontAttribute]: "" }}>
    <svg viewBox="0 0 610 390" aria-hidden="true"><path d="M205 135 L275 187 L205 239" fill="none" stroke="#74c7ec" stroke-width="28" stroke-linecap="round" stroke-linejoin="round"></path><path d="M325 241 L425 241" fill="none" stroke="#74c7ec" stroke-width="24" stroke-linecap="round" {...{ [heroIconCursorAttribute]: "" }}></path></svg>
  </div>
</div>
