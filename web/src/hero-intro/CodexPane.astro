---
import { codexTranscript } from "./hero-terminal-transcripts";
import { heroTranscriptTierAttribute } from "./hero-intro-dom-contract";
---

<section class="hero-terminal-pane hero-terminal-pane--codex" aria-hidden="true">
  <div class="hero-terminal-transcript">
    <div class="hero-codex-startup">
      <div><span class="hero-terminal-muted">&gt;_ </span><strong>OpenAI Codex</strong><span class="hero-terminal-muted"> (v0.156.1)</span></div>
      <div class="hero-codex-startup-blank"></div>
      <div><span class="hero-terminal-muted">model:　　</span>GPT-6-Sol high　<span class="hero-terminal-blue">/model</span><span class="hero-terminal-muted"> to change</span></div>
      <div><span class="hero-terminal-muted">directory: </span>~/tool-portal</div>
    </div>
    {
      codexTranscript.map((row) => (
        <div
          class={`hero-transcript-row hero-transcript-row--${row.kind}`}
          {...{ [heroTranscriptTierAttribute]: row.tiers.join(" ") }}
        >
          {row.text}
        </div>
      ))
    }
  </div>
  <div class="hero-codex-footer">
    <div class="hero-codex-input"><span>›</span><span>Ask Codex to do anything</span></div>
    <div class="hero-codex-status"><span class="hero-terminal-amber">GPT-6-Sol high</span> · <span class="hero-terminal-peach">Context 94% left</span> · <span class="hero-terminal-lavender">fix/lease-client</span></div>
  </div>
</section>
