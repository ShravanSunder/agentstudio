---
import { Image } from "astro:assets";

import { marketingCopy } from "@/marketing-copy";

import { productPlateStories } from "./product-plate-fixture";
---

<section id="workspace" class="px-page-inline pt-section" aria-labelledby="workspace-title">
  <div class="section-heading mb-content max-w-[900px]">
    <p class="eyebrow m-0 font-mono-product text-[12px] tracking-[0.12em] text-ink-faint uppercase">
      {marketingCopy.switcher.eyebrow}
    </p>
    <h2
      id="workspace-title"
      class="mt-[14px] mb-[20px] font-display text-[clamp(48px,6.4vw,94px)] leading-[0.92] font-extrabold tracking-[-0.06em]"
    >
      {marketingCopy.switcher.headline}
    </h2>
    <p class="m-0 max-w-[700px] text-[19px] leading-[1.55] text-ink-muted">
      {marketingCopy.switcher.description}
    </p>
  </div>

  <div
    class="product-plate grid grid-cols-[280px_minmax(0,1fr)] overflow-clip rounded-product border border-line-strong bg-product-ground max-product-stacked:grid-cols-1"
    data-product-plate
    data-enhanced="false"
  >
    <div
      class="product-plate__selector-stage contents max-product-stacked:relative max-product-stacked:grid max-product-stacked:grid-cols-[52px_minmax(0,1fr)_52px] max-phone:grid-cols-[42px_minmax(0,1fr)_42px]"
    >
      <button
        type="button"
        class="product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-r border-line bg-canvas text-[24px] text-primary disabled:cursor-default disabled:text-ink-faint max-product-stacked:grid"
        data-product-plate-previous
        aria-label="Previous workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>

      <div
        id="product-plate-story-selector"
        class="product-plate__selectors border-r border-line-strong bg-canvas max-product-stacked:flex max-product-stacked:overflow-x-auto max-product-stacked:scroll-smooth max-product-stacked:border-r-0 max-product-stacked:[scroll-snap-type:x_mandatory]"
        data-product-plate-selectors
        aria-label={marketingCopy.switcher.accessibilityLabel}
      >
        {
          productPlateStories.map((story, index) => (
            <button
              type="button"
              data-product-plate-selector={story.id}
              disabled
              tabindex="-1"
              class:list={[
                "product-plate__selector grid w-full grid-cols-[34px_minmax(0,1fr)] border-0 border-b border-line bg-transparent px-[20px] py-[clamp(7.5px,calc(1.25vw-10.5px),9.5px)] text-left text-ink-muted max-product-stacked:min-h-[164px] max-product-stacked:[flex:0_0_100%] max-product-stacked:[scroll-snap-align:start] max-product-stacked:grid-cols-[44px_minmax(0,1fr)] max-product-stacked:border-0 max-product-stacked:px-[clamp(24px,4vw,48px)] max-product-stacked:py-[24px] max-phone:min-h-[210px] max-phone:px-[18px]",
                { "is-default": index === 0 },
              ]}
            >
              <span class="row-span-2 font-mono-product text-[12px] text-ink-faint max-product-stacked:text-[14px]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <strong class="text-[16px] text-inherit max-product-stacked:text-[clamp(22px,2.4vw,30px)]">
                {story.label}
              </strong>
              <small class="mt-[7px] max-w-[760px] leading-[1.4] text-ink-faint max-product-stacked:text-[17px] max-phone:text-[16px]">
                <span class="max-phone:hidden">{story.description}</span>
                <span class="hidden max-phone:inline">{story.phoneDescription}</span>
              </small>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        class="product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-l border-line bg-canvas text-[24px] text-primary disabled:cursor-default disabled:text-ink-faint max-product-stacked:grid"
        data-product-plate-next
        aria-label="Next workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="product-plate__panels min-w-0 bg-product-ground">
      {
        productPlateStories.map((story, index) => (
          <article
            class="product-plate__panel overflow-clip rounded-none border-0 bg-product-ground"
            data-product-plate-panel={story.id}
            hidden={index !== 0}
          >
            <picture class="block">
              <source
                media="(max-width: 520px)"
                srcset={story.phoneImage.src}
                width={story.phoneImage.width}
                height={story.phoneImage.height}
              />
              <Image
                src={story.image}
                alt={story.alternativeText}
                widths={[720, 1080, 1440, 2160]}
                sizes="(max-width: 800px) 100vw, (max-width: 1200px) 75vw, 1120px"
                format="png"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="block h-auto w-full"
              />
            </picture>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initializePersistenceProof } from "@/product-plate/persistence-proof-controller";
  import { initializeProductPlate } from "@/product-plate/product-plate-controller";

  const productPlateRoot = document.querySelector<HTMLElement>("[data-product-plate]");
  if (productPlateRoot !== null) {
    initializeProductPlate(productPlateRoot);
  }

  for (const persistenceProofRoot of document.querySelectorAll<HTMLElement>(
    "[data-persistence-proof]",
  )) {
    initializePersistenceProof(persistenceProofRoot);
  }
</script>

<style>
  @reference "../styles/global.css";

  .product-plate[data-enhanced="true"] .product-plate__selector {
    @apply cursor-pointer;
  }

  .product-plate__selector[aria-selected="true"],
  .product-plate__selector.is-default:disabled {
    @apply bg-active-surface text-ink;
    box-shadow: inset 4px 0 var(--color-primary);
  }

  .product-plate__selector[aria-selected="true"] small,
  .product-plate__selector.is-default:disabled small {
    @apply text-ink-muted;
  }

  .product-plate__selector[aria-selected="true"] span,
  .product-plate__selector.is-default:disabled span {
    @apply text-primary;
  }

  .product-plate__selectors {
    scrollbar-width: none;
  }

  .product-plate__selectors::-webkit-scrollbar {
    display: none;
  }

  .product-plate__carousel-action:not(:disabled):hover {
    @apply bg-active-surface;
  }

  .product-plate__panel {
    animation: product-panel-enter 200ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .product-plate__panel[hidden] {
    display: none;
  }

  @media (max-width: 1350px) {
    .product-plate__selector-stage::after {
      position: absolute;
      z-index: 1;
      right: 0;
      bottom: 0;
      left: 0;
      height: 1px;
      pointer-events: none;
      background: var(--color-line-strong);
      content: "";
    }

    .product-plate__selector[aria-selected="true"],
    .product-plate__selector.is-default:disabled {
      box-shadow: inset 0 -4px var(--color-primary);
    }
  }

  @keyframes product-panel-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-plate__selectors {
      scroll-behavior: auto;
    }

    .product-plate__panel {
      animation: none;
    }
  }
</style>
