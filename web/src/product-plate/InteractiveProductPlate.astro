---
import { Image } from "astro:assets";

import ScrollMaterialSurface from "@/home-page/ScrollMaterialSurface.astro";
import { marketingCopy } from "@/marketing-copy";

import { productPlateStories } from "./product-plate-fixture";
---

<section id="workspace" class="px-page-inline pt-section" aria-labelledby="workspace-title">
  <div class="section-heading mb-content max-w-section-heading">
    <p class="eyebrow m-0 font-mono-product text-eyebrow tracking-eyebrow text-ink-faint uppercase">
      {marketingCopy.switcher.eyebrow}
    </p>
    <h2
      id="workspace-title"
      class="mt-3.5 mb-5 font-display text-section-title font-extrabold"
    >
      {marketingCopy.switcher.headline}
    </h2>
    <p class="m-0 max-w-copy text-marketing-body text-ink-muted">
      {marketingCopy.switcher.description}
    </p>
  </div>

  <ScrollMaterialSurface
    class="showcase-surface product-plate grid grid-cols-[280px_minmax(0,1fr)] gap-1 overflow-clip border p-1 max-lg:grid-cols-1"
    data-showcase-surface
    data-visual-state="resting"
    data-product-plate
    data-enhanced="false"
  >
    <div
      class="product-plate__selector-stage relative grid min-h-0 grid-cols-1 overflow-clip rounded-material-pane max-lg:grid-cols-[48px_minmax(0,1fr)_48px] max-lg:gap-1 max-phone:grid-cols-[40px_minmax(0,1fr)_40px]"
    >
      <button
        type="button"
        class="scroll-material-pane product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-r border-line bg-transparent text-2xl text-ink-muted transition-[background-color,color,transform] duration-150 ease-out hover:text-ink active:scale-95 motion-reduce:duration-0 disabled:pointer-events-none disabled:cursor-default disabled:text-ink-faint max-lg:grid max-lg:rounded-xl max-lg:border max-lg:border-line max-phone:text-xl"
        data-product-plate-previous
        aria-label="Previous workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>

      <div
        id="product-plate-story-selector"
        class="product-plate__selectors flex min-h-0 flex-col gap-0.5 bg-transparent max-lg:flex-row max-lg:gap-0 max-lg:snap-x max-lg:snap-mandatory max-lg:overflow-x-auto max-lg:scroll-smooth"
        data-product-plate-selectors
        aria-label={marketingCopy.switcher.accessibilityLabel}
      >
        {
          productPlateStories.map((story, index) => (
            <button
              type="button"
              data-product-plate-selector={story.id}
              disabled
              tabindex="-1"
              class:list={[
                "scroll-material-pane product-plate__selector relative isolate grid min-h-0 w-full flex-1 grid-cols-1 content-start items-start overflow-clip rounded-xl border border-line px-5 py-2.5 text-left text-ink-muted transition-colors duration-150 ease-out hover:text-ink active:bg-active-surface motion-reduce:duration-0 disabled:pointer-events-none max-lg:flex max-lg:min-h-16 max-lg:shrink-0 max-lg:grow-0 max-lg:snap-start max-lg:basis-full max-lg:items-center max-lg:justify-center max-lg:px-[clamp(24px,4vw,48px)] max-lg:py-3 max-phone:min-h-14 max-phone:px-4.5 max-phone:py-2.5 max-phone:text-center",
                { "is-default": index === 0 },
              ]}
            >
              <strong class="relative z-[1] text-lg font-bold text-inherit">
                {story.label}
              </strong>
              <span
                class="relative z-[1] mt-2 max-w-[760px] text-sm text-ink-muted max-lg:hidden"
                data-product-plate-description
              >
                <span>{story.description}</span>
              </span>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        class="scroll-material-pane product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-l border-line bg-transparent text-2xl text-ink-muted transition-[background-color,color,transform] duration-150 ease-out hover:text-ink active:scale-95 motion-reduce:duration-0 disabled:pointer-events-none disabled:cursor-default disabled:text-ink-faint max-lg:grid max-lg:rounded-xl max-lg:border max-lg:border-line max-phone:text-xl"
        data-product-plate-next
        aria-label="Next workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div
      class="scroll-material-pane product-plate__panels product-plate__image-column min-w-0 overflow-clip rounded-material-pane"
    >
      {
        productPlateStories.map((story, index) => (
          <article
            class="product-plate__panel overflow-clip rounded-none border-0 bg-transparent max-lg:grid max-lg:gap-1"
            data-product-plate-panel={story.id}
            hidden={index !== 0}
          >
            <picture class="scroll-material-pane product-plate__image-frame block p-1 max-lg:rounded-material-pane max-lg:border max-lg:border-line">
              {
                "phoneImage" in story && story.phoneImage !== undefined && (
                  <source media="(max-width: 620px)" srcset={story.phoneImage.src} />
                )
              }
              <Image
                src={story.image}
                alt={story.alternativeText}
                widths={[720, 1080, 1440, 2160]}
                sizes="(max-width: 800px) 100vw, (max-width: 1200px) 75vw, 1120px"
                format="png"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="block h-auto w-full max-lg:rounded-control"
              />
            </picture>
            <p
              class="scroll-material-pane product-plate__responsive-caption m-0 hidden border-t border-line px-[clamp(20px,4vw,48px)] py-5 text-lg leading-[1.45] text-ink-muted max-lg:block max-lg:rounded-material-pane max-lg:border max-lg:border-line max-phone:px-5 max-phone:py-4 max-phone:text-sm"
              data-product-plate-caption={story.id}
            >
              {story.phoneDescription}
            </p>
          </article>
        ))
      }
    </div>
  </ScrollMaterialSurface>
</section>

<script>
  import { initializePersistenceProof } from "@/product-plate/persistence-proof-controller";
  import { initializeProductPlate } from "@/product-plate/product-plate-controller";

  const productPlateRoot = document.querySelector<HTMLElement>("[data-product-plate]");
  if (productPlateRoot !== null) {
    initializeProductPlate(productPlateRoot);
  }

  for (const persistenceProofRoot of document.querySelectorAll<HTMLElement>(
    "[data-persistence-proof]",
  )) {
    initializePersistenceProof(persistenceProofRoot);
  }

</script>

<style>
  @reference "../styles/global.css";

  .product-plate__image-frame {
    background: transparent;
  }

  .product-plate__selector-stage {
    background: transparent;
  }

  .product-plate[data-enhanced="true"] .product-plate__selector {
    @apply cursor-pointer;
  }

  .product-plate__selector::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: rgb(8 10 15 / 82%);
    backdrop-filter: blur(16px) saturate(110%);
    -webkit-backdrop-filter: blur(16px) saturate(110%);
    transition: opacity 150ms ease-out;
  }

  .product-plate__selector::after {
    content: "";
    position: absolute;
    z-index: 2;
    top: 21px;
    right: 16px;
    width: 8px;
    height: 8px;
    pointer-events: none;
    border-radius: 999px;
    opacity: 0;
    background: var(--color-primary);
  }

  .product-plate__selector[aria-selected="true"]::before,
  .product-plate__selector.is-default:disabled::before {
    opacity: 1;
  }

  .product-plate__selector[aria-selected="true"]::after,
  .product-plate__selector.is-default:disabled::after {
    animation: selected-dot-breathe 3.2s ease-in-out infinite;
  }

  .product-plate__selector[aria-selected="true"],
  .product-plate__selector.is-default:disabled {
    @apply bg-transparent text-ink;
  }

  .product-plate__selector[aria-selected="true"] strong,
  .product-plate__selector.is-default:disabled strong {
    @apply text-ink;
  }

  .product-plate__selector[aria-selected="true"] [data-product-plate-description],
  .product-plate__selector.is-default:disabled [data-product-plate-description] {
    @apply text-ink/85;
  }

  .product-plate__selectors {
    scrollbar-width: none;
  }

  .product-plate__selectors::-webkit-scrollbar {
    display: none;
  }

  .product-plate__panel {
    animation: product-panel-enter 200ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .product-plate__panel[hidden] {
    display: none;
  }

  @media (width < 64rem) {
    .product-plate__image-column {
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .product-plate__image-frame {
      background: var(--scroll-material-pane-background);
    }

    .product-plate__panel {
      animation: none;
    }

    .product-plate__selector::after {
      display: none;
    }

    .product-plate__selector[aria-selected="true"]::before,
    .product-plate__selector.is-default:disabled::before {
      opacity: 0;
    }

    .product-plate__carousel-action:active {
      background: var(--color-active-surface);
    }

    .product-plate__selector[aria-selected="true"],
    .product-plate__selector.is-default:disabled {
      @apply text-ink;
      background: var(--scroll-material-pane-background);
    }

    .product-plate__selector[aria-selected="true"] strong,
    .product-plate__selector.is-default:disabled strong {
      @apply text-ink;
    }
  }

  @keyframes product-panel-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes selected-dot-breathe {
    0%,
    100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.8;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-plate__selector::before {
      transition: none;
    }

    .product-plate__selector[aria-selected="true"]::after,
    .product-plate__selector.is-default:disabled::after {
      animation: none;
      opacity: 0.8;
    }

    .product-plate__selectors {
      scroll-behavior: auto;
    }

    .product-plate__panel {
      animation: none;
    }
  }
</style>
