---
import { Image } from "astro:assets";

import { marketingCopy } from "@/marketing-copy";

import { productPlateStories } from "./product-plate-fixture";
---

<section id="workspace" class="px-page-inline pt-section" aria-labelledby="workspace-title">
  <div class="section-heading mb-content max-w-section-heading">
    <p class="eyebrow m-0 font-mono-product text-eyebrow tracking-eyebrow text-ink-faint uppercase">
      {marketingCopy.switcher.eyebrow}
    </p>
    <h2
      id="workspace-title"
      class="mt-3.5 mb-5 font-display text-section-title font-extrabold"
    >
      {marketingCopy.switcher.headline}
    </h2>
    <p class="m-0 max-w-copy text-marketing-body text-ink-muted">
      {marketingCopy.switcher.description}
    </p>
  </div>

  <div
    class="product-plate grid grid-cols-[280px_minmax(0,1fr)] overflow-clip rounded-product border border-line-strong bg-product-ground max-site-edge:grid-cols-1"
    data-product-plate
    data-enhanced="false"
  >
    <div
      class="product-plate__selector-stage contents max-site-edge:relative max-site-edge:grid max-site-edge:grid-cols-[52px_minmax(0,1fr)_52px] max-phone:grid-cols-[40px_minmax(0,1fr)_40px]"
    >
      <button
        type="button"
        class="product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-r border-line bg-canvas text-[24px] text-primary disabled:cursor-default disabled:text-ink-faint max-site-edge:grid max-site-edge:text-ink max-phone:text-[20px]"
        data-product-plate-previous
        aria-label="Previous workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">←</span>
      </button>

      <div
        id="product-plate-story-selector"
        class="product-plate__selectors border-r border-line-strong bg-canvas max-site-edge:flex max-site-edge:snap-x max-site-edge:snap-mandatory max-site-edge:overflow-x-auto max-site-edge:scroll-smooth max-site-edge:border-r-0"
        data-product-plate-selectors
        aria-label={marketingCopy.switcher.accessibilityLabel}
      >
        {
          productPlateStories.map((story, index) => (
            <button
              type="button"
              data-product-plate-selector={story.id}
              disabled
              tabindex="-1"
              class:list={[
                "product-plate__selector relative grid w-full grid-cols-[34px_minmax(0,1fr)] border-0 border-b border-line bg-transparent px-5 py-[clamp(7.5px,calc(1.25vw-10.5px),9.5px)] text-left text-ink-muted max-site-edge:flex max-site-edge:min-h-22 max-site-edge:shrink-0 max-site-edge:grow-0 max-site-edge:snap-start max-site-edge:basis-full max-site-edge:items-center max-site-edge:justify-center max-site-edge:gap-3 max-site-edge:border-0 max-site-edge:px-[clamp(24px,4vw,48px)] max-site-edge:py-4.5 max-phone:min-h-19 max-phone:gap-2.5 max-phone:px-4.5 max-phone:py-3.5 max-phone:text-center",
                { "is-default": index === 0 },
              ]}
            >
              <span
                class="row-span-2 font-mono-product text-[12px] text-ink-faint max-site-edge:text-[13px] max-phone:text-[11px]"
                data-product-plate-index
              >
                {String(index + 1).padStart(2, "0")}
              </span>
              <strong class="text-[16px] text-inherit max-site-edge:text-[20px] max-site-edge:leading-tight max-phone:text-[18px]">
                {story.label}
              </strong>
              <small class="mt-1.75 max-w-[760px] leading-[1.4] text-ink-faint max-site-edge:hidden">
                <span>{story.description}</span>
              </small>
            </button>
          ))
        }
      </div>

      <button
        type="button"
        class="product-plate__carousel-action hidden cursor-pointer place-items-center border-0 border-l border-line bg-canvas text-[24px] text-primary disabled:cursor-default disabled:text-ink-faint max-site-edge:grid max-site-edge:text-ink max-phone:text-[20px]"
        data-product-plate-next
        aria-label="Next workspace view"
        aria-controls="product-plate-story-selector"
        disabled
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <div class="product-plate__panels min-w-0 bg-product-ground">
      {
        productPlateStories.map((story, index) => (
          <article
            class="product-plate__panel overflow-clip rounded-none border-0 bg-product-ground"
            data-product-plate-panel={story.id}
            hidden={index !== 0}
          >
            <picture class="block">
              <Image
                src={story.image}
                alt={story.alternativeText}
                widths={[720, 1080, 1440, 2160]}
                sizes="(max-width: 800px) 100vw, (max-width: 1200px) 75vw, 1120px"
                format="png"
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                class="block h-auto w-full"
              />
            </picture>
            <p
              class="product-plate__responsive-caption m-0 hidden border-t border-line bg-canvas px-[clamp(20px,4vw,48px)] py-5 text-[17px] leading-[1.45] text-ink-muted max-site-edge:block max-phone:px-5 max-phone:py-4 max-phone:text-[15px]"
              data-product-plate-caption={story.id}
            >
              {story.phoneDescription}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { initializePersistenceProof } from "@/product-plate/persistence-proof-controller";
  import { initializeProductPlate } from "@/product-plate/product-plate-controller";

  const productPlateRoot = document.querySelector<HTMLElement>("[data-product-plate]");
  if (productPlateRoot !== null) {
    initializeProductPlate(productPlateRoot);
  }

  for (const persistenceProofRoot of document.querySelectorAll<HTMLElement>(
    "[data-persistence-proof]",
  )) {
    initializePersistenceProof(persistenceProofRoot);
  }
</script>

<style>
  @reference "../styles/global.css";

  .product-plate[data-enhanced="true"] .product-plate__selector {
    @apply cursor-pointer;
  }

  .product-plate__selector[aria-selected="true"],
  .product-plate__selector.is-default:disabled {
    @apply bg-active-surface text-ink;
  }

  .product-plate__selector[aria-selected="true"]::before,
  .product-plate__selector.is-default:disabled::before {
    @apply absolute inset-y-3 left-0 w-1 rounded-full bg-primary;
    content: "";
  }

  .product-plate__selector[aria-selected="true"] small,
  .product-plate__selector.is-default:disabled small {
    @apply text-ink-muted;
  }

  .product-plate__selector[aria-selected="true"] [data-product-plate-index],
  .product-plate__selector.is-default:disabled [data-product-plate-index] {
    @apply text-ink;
  }

  .product-plate__selectors {
    scrollbar-width: none;
  }

  .product-plate__selectors::-webkit-scrollbar {
    display: none;
  }

  .product-plate__carousel-action:not(:disabled):hover {
    @apply bg-active-surface;
  }

  .product-plate__panel {
    animation: product-panel-enter 200ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .product-plate__panel[hidden] {
    display: none;
  }

  @media (width < 56.25rem) {
    .product-plate__selector-stage::after {
      @apply pointer-events-none absolute right-0 bottom-0 left-0 z-[1] h-px bg-line-strong;
      content: "";
    }

    .product-plate__selector[aria-selected="true"],
    .product-plate__selector.is-default:disabled {
      @apply bg-active-surface text-ink;
    }

    .product-plate__selector[aria-selected="true"]::before,
    .product-plate__selector.is-default:disabled::before {
      @apply inset-y-0 rounded-none;
    }
  }

  @keyframes product-panel-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-plate__selectors {
      scroll-behavior: auto;
    }

    .product-plate__panel {
      animation: none;
    }
  }
</style>
