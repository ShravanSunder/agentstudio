---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import { marketingCopy } from "@/marketing-copy";

interface Props {
  readonly beforeImage: ImageMetadata;
  readonly restoredImage: ImageMetadata;
}

const { beforeImage, restoredImage } = Astro.props;
---

<div class="persistence-proof" data-persistence-proof data-enhanced="false">
  <div
    class="flex min-h-12 border-b border-line-strong bg-canvas"
    role="group"
    aria-label="Workspace restoration"
  >
    <button
      type="button"
      class="persistence-proof__control relative min-w-32 cursor-pointer border-0 border-r border-line bg-transparent px-4.5 font-mono-product text-[12px] text-ink-muted uppercase max-phone:min-w-0 max-phone:flex-[1_1_50%]"
      data-persistence-proof-button="before"
      aria-pressed="true"
      disabled
    >
      {marketingCopy.stories.persistence.beforeLabel}
    </button>
    <button
      type="button"
      class="persistence-proof__control relative min-w-32 cursor-pointer border-0 border-r border-line bg-transparent px-4.5 font-mono-product text-[12px] text-ink-muted uppercase max-phone:min-w-0 max-phone:flex-[1_1_50%]"
      data-persistence-proof-button="restored"
      aria-pressed="false"
      disabled
    >
      {marketingCopy.stories.persistence.restoredLabel}
    </button>
  </div>

  <figure class="m-0" data-persistence-frame="before">
    <Image
      src={beforeImage}
      alt={marketingCopy.stories.persistence.beforeImageDescription}
      widths={[720, 1080, 1440, 2160]}
      sizes="(max-width: 800px) 100vw, (max-width: 1200px) 75vw, 1120px"
      format="png"
      loading="lazy"
      decoding="async"
      class="block h-auto w-full"
    />
  </figure>
  <figure class="m-0" data-persistence-frame="restored" hidden>
    <Image
      src={restoredImage}
      alt={marketingCopy.stories.persistence.restoredImageDescription}
      widths={[720, 1080, 1440, 2160]}
      sizes="(max-width: 800px) 100vw, (max-width: 1200px) 75vw, 1120px"
      format="png"
      loading="lazy"
      decoding="async"
      class="block h-auto w-full"
    />
  </figure>
</div>

<style>
  @reference "../styles/global.css";

  .persistence-proof__control[aria-pressed="true"] {
    @apply bg-active-surface text-ink;
  }

  .persistence-proof__control[aria-pressed="true"]::after {
    @apply absolute right-4 bottom-0 left-4 h-0.5 bg-primary;
    content: "";
  }
</style>
