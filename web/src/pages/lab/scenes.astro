---
// Dev-only scene review page for contact sheets. Not linked, noindex, and
// absent from sitemap.xml; lane D deletes it before release.
import { chapterCatalog } from "@/chapters/chapter-catalog";
import ChapterContextWithTaskScene from "@/motion-scenes/scenes/chapter-context-with-task/ChapterContextWithTaskScene.astro";
import ChapterFindAndFocusScene from "@/motion-scenes/scenes/chapter-find-and-focus/ChapterFindAndFocusScene.astro";
import ChapterManyAgentsScene from "@/motion-scenes/scenes/chapter-many-agents/ChapterManyAgentsScene.astro";
import { resolveSceneModule } from "@/motion-scenes/scene-registry";
import type { SceneId } from "@/motion-scenes/scene-contract";
import "@/styles/global.css";

interface LabScene {
  readonly sceneId: SceneId;
  readonly title: string;
  readonly stepLabels: readonly { readonly timelineLabel: string; readonly label: string }[];
}

const labScenes: readonly LabScene[] = chapterCatalog.flatMap((chapter): LabScene[] => {
  if (chapter.stage.kind !== "scene") {
    return [];
  }
  const sceneModule = resolveSceneModule(chapter.stage.sceneId);
  return [
    {
      sceneId: chapter.stage.sceneId,
      title: `${chapter.eyebrow}: ${chapter.title.beforeAccent}${chapter.title.accent}${chapter.title.afterAccent}`,
      stepLabels: chapter.steps.map((step) => ({
        timelineLabel:
          sceneModule?.steps.find((sceneStep) => sceneStep.stepId === step.id)?.timelineLabel ??
          step.id,
        label: step.label,
      })),
    },
  ];
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Scene lab · Agent Studio</title>
  </head>
  <body class="px-4 pb-16">
    <header class="mx-auto max-w-[1280px] py-6">
      <h1 class="text-2xl font-semibold">Scene lab</h1>
      <p class="mt-1 text-ink-faint">
        Each stage opens on its settled frame. Use the controls, or deep-link with
        <code>?scene=&lt;sceneId&gt;&amp;at=&lt;label | label-end | start | settled&gt;</code>.
      </p>
    </header>
    <main class="mx-auto flex max-w-[1280px] flex-col gap-14">
      {
        labScenes.map((labScene) => (
          <section class="lab-scene flex flex-col gap-3" data-lab-scene={labScene.sceneId}>
            <h2 class="text-lg font-semibold">
              {labScene.title} <span class="text-ink-faint">({labScene.sceneId})</span>
            </h2>
            <div class="lab-scene__stage mx-auto" data-lab-stage>
              {labScene.sceneId === "chapter-many-agents" ? <ChapterManyAgentsScene /> : null}
              {labScene.sceneId === "chapter-context-with-task" ? (
                <ChapterContextWithTaskScene />
              ) : null}
              {labScene.sceneId === "chapter-find-and-focus" ? <ChapterFindAndFocusScene /> : null}
            </div>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <button class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10" type="button" data-lab-action="play">
                Play
              </button>
              <button class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10" type="button" data-lab-action="pause">
                Pause
              </button>
              <button class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10" type="button" data-lab-action="start">
                Start
              </button>
              <button class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10" type="button" data-lab-action="settled">
                Settled
              </button>
              <span class="mx-2 h-5 w-px bg-line-strong" />
              {labScene.stepLabels.map((stepLabel) => (
                <span class="inline-flex gap-1">
                  <button class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10" type="button" data-lab-seek={stepLabel.timelineLabel}>
                    {stepLabel.label}
                  </button>
                  <button
                    class="rounded-md border border-line-strong bg-white/5 px-2.5 py-1 hover:bg-white/10"
                    type="button"
                    data-lab-seek={`${stepLabel.timelineLabel}-end`}
                  >
                    end
                  </button>
                </span>
              ))}
            </div>
            <div class="flex items-center gap-3 text-sm">
              <input
                class="flex-1"
                type="range"
                min="0"
                max="1000"
                value="1000"
                aria-label={`Scrub ${labScene.sceneId}`}
                data-lab-scrubber
              />
              <output class="w-64 text-right font-mono text-ink-faint" data-lab-readout>
                settled
              </output>
            </div>
          </section>
        ))
      }
    </main>
  </body>
</html>

<script>
  import { gsap } from "gsap";

  import { sceneRootAttribute } from "@/chapters/chapter-dom-contract";
  import { isSceneId, type SceneTimeline } from "@/motion-scenes/scene-contract";
  import { resolveSceneModule } from "@/motion-scenes/scene-registry";

  // The lab's fixed seed; the same seed the site's host uses keeps frames comparable.
  const labSeed = 1;

  function findStepBoundaryTime(timeline: SceneTimeline, seekTarget: string): number | undefined {
    if (seekTarget === "start") {
      return 0;
    }
    if (seekTarget === "settled") {
      return timeline.duration();
    }
    const endSuffix = "-end";
    const isStepEnd = seekTarget.endsWith(endSuffix);
    const labelName = isStepEnd ? seekTarget.slice(0, -endSuffix.length) : seekTarget;
    const labelTime = timeline.labels[labelName];
    if (labelTime === undefined) {
      return undefined;
    }
    if (!isStepEnd) {
      return labelTime;
    }
    // A step's end is the instant before the next step begins: its beat, complete.
    const laterLabelTimes = Object.values(timeline.labels).filter((time) => time > labelTime);
    return laterLabelTimes.length === 0
      ? timeline.duration()
      : Math.min(...laterLabelTimes) - 0.001;
  }

  function describeTime(timeline: SceneTimeline): string {
    const time = timeline.time();
    const currentLabel = Object.entries(timeline.labels)
      .filter(([, labelTime]) => labelTime <= time + 0.0005)
      .sort(([, first], [, second]) => second - first)[0]?.[0];
    return `${time.toFixed(2)} s / ${timeline.duration().toFixed(2)} s · ${currentLabel ?? ""}`;
  }

  function initializeLabScene(section: HTMLElement, pageParameters: URLSearchParams): void {
    const root = section.querySelector<HTMLElement>(`[${sceneRootAttribute}]`);
    const sceneId = root?.getAttribute(sceneRootAttribute) ?? "";
    const scrubber = section.querySelector<HTMLInputElement>("[data-lab-scrubber]");
    const readout = section.querySelector<HTMLOutputElement>("[data-lab-readout]");
    if (root === null || !isSceneId(sceneId) || scrubber === null || readout === null) {
      throw new Error(`Scene lab section is incomplete: ${section.dataset["labScene"] ?? ""}`);
    }
    const sceneModule = resolveSceneModule(sceneId);
    if (sceneModule === undefined) {
      readout.value = "no module registered";
      return;
    }
    const timeline = gsap.timeline({ paused: true });
    sceneModule.buildScene(root, timeline, {
      width: root.clientWidth,
      height: root.clientHeight,
      seed: labSeed,
    });

    const render = (): void => {
      scrubber.value = String(Math.round(timeline.progress() * 1000));
      readout.value = describeTime(timeline);
      section.dataset["labTime"] = timeline.time().toFixed(3);
    };
    const seek = (seekTarget: string): void => {
      const time = findStepBoundaryTime(timeline, seekTarget);
      if (time !== undefined) {
        timeline.pause(time);
        render();
      }
    };
    timeline.eventCallback("onUpdate", render);

    section.querySelectorAll<HTMLButtonElement>("[data-lab-action]").forEach((button) => {
      button.addEventListener("click", () => {
        switch (button.dataset["labAction"]) {
          case "play":
            if (timeline.progress() >= 1) {
              timeline.restart();
            } else {
              timeline.play();
            }
            break;
          case "pause":
            timeline.pause();
            render();
            break;
          case "start":
            seek("start");
            break;
          case "settled":
            seek("settled");
            break;
          default:
            break;
        }
      });
    });
    section.querySelectorAll<HTMLButtonElement>("[data-lab-seek]").forEach((button) => {
      button.addEventListener("click", () => {
        seek(button.dataset["labSeek"] ?? "settled");
      });
    });
    scrubber.addEventListener("input", () => {
      timeline.pause();
      timeline.progress(Number(scrubber.value) / 1000);
      render();
    });

    const requestedScene = pageParameters.get("scene");
    const requestedTime = requestedScene === sceneId ? pageParameters.get("at") : null;
    seek(requestedTime ?? "settled");
  }

  const pageParameters = new URLSearchParams(window.location.search);
  const onlyScene = pageParameters.get("scene");
  document.querySelectorAll<HTMLElement>("[data-lab-scene]").forEach((section) => {
    if (onlyScene !== null && section.dataset["labScene"] !== onlyScene) {
      section.hidden = true;
      return;
    }
    initializeLabScene(section, pageParameters);
  });
  document.documentElement.dataset["labReady"] = "true";
</script>

<style is:global>
  /* The dev toolbar would sit over the stage in operator screenshots. */
  astro-dev-toolbar {
    display: none;
  }
</style>

<style>
  /* A 16:10 stage that fits one viewport so an operator can screenshot each beat. */
  .lab-scene__stage {
    width: min(100%, calc((100svh - 9rem) * 1.6));
    aspect-ratio: 16 / 10;
  }

</style>
