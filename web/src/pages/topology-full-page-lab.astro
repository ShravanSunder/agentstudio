---
import FullPageTopologyArtwork from "@/topology-lab/FullPageTopologyArtwork.astro";
import "@/styles/global.css";

const glassSurfaces = [840, 1720, 2660, 3600] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2E3036" />
    <title>Agent Studio full-page topology lab</title>
  </head>
  <body>
    <main class="relative h-[5200px] min-w-[1280px] overflow-hidden bg-canvas">
      <div class="absolute inset-0 z-0">
        <FullPageTopologyArtwork
          mainlineAnchorSelector="[data-topology-lab-anchor]"
          portalFrameSelector="[data-topology-lab-frame]"
          portalSurfaceSelector="[data-topology-lab-surface]"
        />
      </div>

      <div
        class="pointer-events-none absolute top-24 right-36 size-px"
        data-topology-lab-anchor
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute inset-y-0 left-1/2 w-[min(calc(100%-32px),1440px)] -translate-x-1/2"
        data-topology-lab-frame
        aria-hidden="true"
      ></div>

      {
        glassSurfaces.map((top) => (
          <div
            class="pointer-events-none absolute left-1/2 h-[560px] w-[min(calc(100%-32px),1440px)] -translate-x-1/2"
            style={`top: ${top}px`}
            data-topology-lab-surface
            aria-hidden="true"
          ></div>
        ))
      }
    </main>
  </body>
</html>
