---
import type { GetStaticPaths } from "astro";

import { campaignChannels } from "@/campaign-attribution/campaign-attribution-registry";
import HomePage from "@/home-page/HomePage.astro";

export const prerender = true;

export const getStaticPaths = (() =>
  campaignChannels.map((channel) => ({ params: { channel } }))) satisfies GetStaticPaths;
---

<HomePage canonicalPath="/" socialUrlPath="/" />
