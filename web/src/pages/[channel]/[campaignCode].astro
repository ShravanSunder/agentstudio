---
import type { GetStaticPaths } from "astro";

import {
  campaignAttributionRegistry,
} from "@/campaign-attribution/campaign-attribution-registry";
import HomePage from "@/home-page/HomePage.astro";

export const prerender = true;

export const getStaticPaths = (() =>
  campaignAttributionRegistry.routes.map((campaignRoute) => ({
    params: {
      campaignCode: campaignRoute.code,
      channel: campaignRoute.channel,
    },
  }))) satisfies GetStaticPaths;
---

<HomePage canonicalPath="/" socialUrlPath="/" />
