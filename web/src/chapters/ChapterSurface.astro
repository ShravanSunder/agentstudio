---
import ScrollMaterialSurface from "@/home-page/ScrollMaterialSurface.astro";

import ChapterStepPill from "./ChapterStepPill.astro";
import type { Chapter } from "./chapter-catalog";
import {
  playbackStageAttribute,
  railAnchorAttribute,
  railMediaTargetAttribute,
  railSurfaceTargetAttribute,
} from "./chapter-dom-contract";

interface Props {
  readonly chapter: Chapter;
}

const { chapter } = Astro.props;
const titleId = `chapter-${chapter.id}-title`;
const hasStepSelector = chapter.steps.length > 1;
const railAnchorAttributes = { [railAnchorAttribute]: chapter.id };
const surfaceAttributes = { [railSurfaceTargetAttribute]: chapter.id };
const stageAttributes = { [railMediaTargetAttribute]: chapter.id, [playbackStageAttribute]: "" };
---

<!-- The public /#chapterId anchor clears the floating header on arrival. -->
<article
  id={chapter.id}
  class="chapter-section scroll-mt-24 py-chapter-block pr-page-inline pl-[calc(var(--spacing-page-inline)+var(--spacing-rail-gutter))]"
  aria-labelledby={titleId}
  data-chapter={chapter.id}
>
  <div class="chapter-flow" data-chapter-steps-root={chapter.id} data-has-steps={String(hasStepSelector)}>
    <h2
      {...railAnchorAttributes}
      id={titleId}
      class="chapter-title m-0 font-display text-[clamp(30px,3.4vw,60px)] leading-[0.98] font-extrabold tracking-[-0.045em] text-balance text-ink"
    >
      {chapter.title.beforeAccent}<span class="text-primary">{chapter.title.accent}</span
      >{chapter.title.afterAccent}
    </h2>

    {hasStepSelector && <div class="chapter-pill-slot"><ChapterStepPill chapterId={chapter.id} steps={chapter.steps} /></div>}

    <ScrollMaterialSurface
      {...surfaceAttributes}
      class="chapter-surface border p-1"
    >
      <div
        {...stageAttributes}
        class="scroll-material-pane chapter-surface__stage relative flex w-full min-w-0 items-center overflow-clip rounded-material-pane border border-line p-1"
      >
        <slot name="stage" />
      </div>
    </ScrollMaterialSurface>

    <div class="chapter-caption" data-chapter-caption>
      {
        hasStepSelector ? (
          chapter.steps.map((step, stepIndex) => (
            <div class="chapter-step-panel" data-chapter-step-panel={step.id} aria-hidden={stepIndex !== 0}>
              <p class="m-0 max-phone:hidden">{step.description}</p>
              <p class="m-0 hidden max-phone:block">{step.phoneDescription}</p>
            </div>
          ))
        ) : (
          chapter.steps.map((step) => (
            <div class="chapter-single-description">
              <p class="m-0 max-phone:hidden">{step.description}</p>
              <p class="m-0 hidden max-phone:block">{step.phoneDescription}</p>
            </div>
          ))
        )
      }
    </div>
  </div>
</article>

<script>
  import { initializeChapterSteps } from "./chapter-step-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-chapter-steps-root]")) {
    if (root.querySelector("[data-chapter-step-list]") !== null) {
      initializeChapterSteps(root);
    }
  }
</script>

<style>
  .chapter-flow { display: flex; flex-direction: column; min-width: 0; }
  .chapter-title { order: 1; }
  .chapter-pill-slot { order: 2; margin-top: 14px; margin-bottom: 14px; align-self: flex-start; max-width: 100%; }
  :global(.chapter-surface) { order: 3; }
  .chapter-caption { order: 4; margin-top: 12px; }
  .chapter-flow[data-has-steps="false"] :global(.chapter-surface) { margin-top: 20px; }
  @media (width < 64rem) {
    :global(.chapter-surface) { order: 2; margin-top: 20px; }
    .chapter-pill-slot { order: 3; margin-top: 14px; margin-bottom: 0; }
    .chapter-caption { margin-top: 10px; }
  }
  :global(.chapter-surface.scroll-material-surface[data-rail-current]) {
    border-color: rgb(137 180 250 / 88%);
  }
</style>
