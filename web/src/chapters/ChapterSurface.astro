---
import ScrollMaterialSurface from "@/home-page/ScrollMaterialSurface.astro";

import type { Chapter } from "./chapter-catalog";
import {
  playbackStageAttribute,
  railAnchorAttribute,
  railMediaTargetAttribute,
  railSurfaceTargetAttribute,
} from "./chapter-dom-contract";

interface Props {
  readonly chapter: Chapter;
}

// Accessible names for the scene's pause control (WCAG 2.2.2: motion that runs
// longer than five seconds must be pausable). Copy pass: lane D may move these
// into marketing-copy.ts.
const scenePauseLabel = "Pause animation";
const scenePlayLabel = "Play animation";

const { chapter } = Astro.props;
const titleId = `chapter-${chapter.id}-title`;
const hasStepSelector = chapter.steps.length > 1;
const hasScenePlayback = chapter.stage.kind === "scene";
const railAnchorAttributes = { [railAnchorAttribute]: chapter.id };
const surfaceAttributes = { [railSurfaceTargetAttribute]: chapter.id };
const stageAttributes = { [railMediaTargetAttribute]: chapter.id, [playbackStageAttribute]: "" };
---

<article
  class="chapter-section py-[clamp(48px,5vw,76px)] pr-page-inline pl-[calc(var(--spacing-page-inline)+var(--chapter-rail-gutter))] max-phone:py-10"
  aria-labelledby={titleId}
  data-chapter={chapter.id}
>
  <ScrollMaterialSurface
    {...surfaceAttributes}
    class="chapter-surface grid grid-cols-[minmax(0,35fr)_minmax(0,65fr)] gap-1 border p-1 max-lg:grid-cols-1 max-phone:gap-6 max-phone:p-0"
    data-chapter-steps-root={chapter.id}
  >
    <div
      class="scroll-material-pane chapter-surface__copy flex min-w-0 flex-col rounded-material-pane border border-line p-[clamp(28px,3vw,48px)] max-lg:contents"
    >
      <header class="max-lg:order-1 max-lg:px-7 max-lg:pt-7 max-lg:pb-3 max-phone:p-0">
        <p
          {...railAnchorAttributes}
          class="m-0 font-mono-product text-eyebrow tracking-[0.24em] text-primary uppercase"
        >
          {chapter.eyebrow}
        </p>
        <h2
          id={titleId}
          class="mt-5 mb-0 font-display text-[clamp(30px,3.4vw,60px)] leading-[0.98] font-extrabold tracking-[-0.045em] text-balance text-ink max-phone:mt-3"
        >
          {chapter.title.beforeAccent}<span class="text-primary">{chapter.title.accent}</span
          >{chapter.title.afterAccent}
        </h2>
      </header>

      <div class="mt-12 max-lg:order-3 max-lg:mt-0 max-lg:px-7 max-lg:pt-3 max-lg:pb-7 max-phone:p-0">
        {
          hasStepSelector ? (
            <>
              <div class="chapter-step-list relative grid gap-1" data-chapter-step-list>
                {chapter.steps.map((step, stepIndex) => (
                  <button
                    type="button"
                    class="chapter-step relative z-[1] flex w-full cursor-pointer items-center gap-4 rounded-control py-2.5 pr-2 text-left text-[17px] leading-snug text-ink-faint transition-colors duration-150 hover:text-ink-secondary disabled:cursor-default motion-reduce:transition-none max-phone:text-base"
                    data-chapter-step={step.id}
                    data-step-state={stepIndex === 0 ? "current" : "upcoming"}
                    disabled
                    tabindex="-1"
                  >
                    <span class="chapter-step__dot" aria-hidden="true" />
                    <span>{step.label}</span>
                  </button>
                ))}
              </div>
              {chapter.steps.map((step, stepIndex) => (
                <div
                  class="mt-5 max-w-[440px] rounded-control text-[16px] leading-[1.55] text-ink-muted max-lg:max-w-none max-phone:text-sm"
                  data-chapter-step-panel={step.id}
                  hidden={stepIndex !== 0}
                >
                  <p class="m-0 max-phone:hidden">{step.description}</p>
                  <p class="m-0 hidden max-phone:block">{step.phoneDescription}</p>
                </div>
              ))}
            </>
          ) : (
            chapter.steps.map((step) => (
              <div class="max-w-[440px] text-[16px] leading-[1.55] text-ink-muted max-lg:max-w-none max-phone:text-sm">
                <p class="m-0 text-[17px] text-ink-secondary max-phone:text-base">{step.label}</p>
                <p class="mt-3 mb-0 max-phone:hidden">{step.description}</p>
                <p class="mt-3 mb-0 hidden max-phone:block">{step.phoneDescription}</p>
              </div>
            ))
          )
        }
      </div>
    </div>

    <div
      {...stageAttributes}
      class="scroll-material-pane chapter-surface__stage relative flex min-w-0 items-center overflow-clip rounded-material-pane border border-line p-1 max-lg:order-2"
    >
      <slot name="stage" />
      {
        hasScenePlayback && (
          <button
            type="button"
            class="scene-playback-toggle absolute right-3 bottom-3 z-[3] grid size-9 cursor-pointer place-items-center rounded-full border border-line-strong bg-[rgb(17_17_27/78%)] text-ink-secondary backdrop-blur-md hover:text-ink"
            data-scene-playback-toggle
            data-pause-label={scenePauseLabel}
            data-play-label={scenePlayLabel}
            aria-label={scenePlayLabel}
            hidden
          >
            <svg class="scene-playback-toggle__pause size-3.5" viewBox="0 0 14 14" aria-hidden="true">
              <rect x="2.5" y="2" width="3" height="10" rx="1" fill="currentColor" />
              <rect x="8.5" y="2" width="3" height="10" rx="1" fill="currentColor" />
            </svg>
            <svg class="scene-playback-toggle__play size-3.5" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M4 2.2v9.6a.6.6 0 0 0 .92.5l7.3-4.8a.6.6 0 0 0 0-1L4.92 1.7A.6.6 0 0 0 4 2.2Z" fill="currentColor" />
            </svg>
          </button>
        )
      }
    </div>
  </ScrollMaterialSurface>
</article>

<script>
  import { initializeChapterSteps } from "./chapter-step-controller";

  for (const root of document.querySelectorAll<HTMLElement>("[data-chapter-steps-root]")) {
    if (root.querySelector("[data-chapter-step-list]") !== null) {
      initializeChapterSteps(root);
    }
  }
</script>

<style>
  @reference "../styles/global.css";

  /* The left rail's lane lives in this gutter; the rail reads positions, never sets them. */
  .chapter-section {
    --chapter-rail-gutter: clamp(40px, 4.5vw, 80px);
  }

  /* The step lane: one vertical line behind the dots, like the page rail. */
  .chapter-step-list::before {
    content: "";
    position: absolute;
    top: 22px;
    bottom: 22px;
    left: 6px;
    width: 2px;
    border-radius: 1px;
    background: var(--color-line-strong);
  }

  .chapter-step__dot {
    flex: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgb(155 161 173 / 70%);
    border-radius: 999px;
    background: var(--color-ground);
  }

  .chapter-step[data-step-state="passed"] .chapter-step__dot {
    border-color: var(--color-ink-faint);
    background: var(--color-ink-faint);
  }

  .chapter-step[data-step-state="current"] {
    @apply text-ink;
  }

  .chapter-step[data-step-state="current"] .chapter-step__dot {
    border-color: var(--color-primary);
    background: var(--color-primary);
    box-shadow:
      0 0 0 3px var(--color-ground),
      0 0 0 5px rgb(137 180 250 / 55%);
  }

  .scene-playback-toggle__play,
  .scene-playback-toggle[data-scene-playback-state="playing"] .scene-playback-toggle__pause {
    display: block;
  }

  .scene-playback-toggle__pause,
  .scene-playback-toggle[data-scene-playback-state="playing"] .scene-playback-toggle__play {
    display: none;
  }

  /* The rail marks the current chapter's target; its hairline lights blue. */
  :global(.chapter-surface.scroll-material-surface[data-rail-current]) {
    border-color: rgb(137 180 250 / 88%);
  }

  @media (width < 38.75rem) {
    .chapter-section {
      --chapter-rail-gutter: 22px;
    }

    /* Phone: the copy sits beside the rail and the media stage is the glass. */
    :global(.chapter-surface.scroll-material-surface[data-scroll-material-surface]) {
      border-width: 0;
      background: none;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    :global(.chapter-surface[data-rail-current]) .chapter-surface__stage,
    .chapter-surface__stage:global([data-rail-current]) {
      border-color: var(--color-primary);
    }
  }
</style>
