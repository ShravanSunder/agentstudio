---
// The page's left progress rail: a git-graph grid (main lane plus worktree
// lanes, one dot per row) drawn behind the content by
// chapter-rail-controller.ts. Decorative only; without script, or on a page
// with no rail anchors, the SVG stays empty.
---

<div
  class="chapter-rail pointer-events-none absolute inset-0 z-0 overflow-hidden"
  data-chapter-rail
  aria-hidden="true"
>
  <svg class="block h-full w-full" data-chapter-rail-artwork aria-hidden="true" focusable="false"
  ></svg>
</div>

<script>
  import { initializeChapterRail } from "./chapter-rail-controller";

  const chapterRail = document.querySelector<HTMLElement>("[data-chapter-rail]");
  if (chapterRail !== null) {
    initializeChapterRail(chapterRail);
  }
</script>

<style>
  /* The controller creates the lane, branches and dots at runtime, so these
     selectors reach them through :global() under the scoped container. Lane
     strokes, node sizes and the terminal halo follow the retired topology
     artwork (topology-lab/FullPageTopologyArtwork.astro at 721d72458). */
  .chapter-rail {
    --chapter-rail-lane: color-mix(
      in srgb,
      color-mix(in srgb, var(--color-primary) 45%, var(--color-ink-faint)) 42%,
      transparent
    );
    --chapter-rail-muted: color-mix(in srgb, var(--color-ink-faint) 62%, transparent);
    --chapter-rail-current: var(--color-primary);
    --chapter-rail-transition: 240ms ease;
  }

  .chapter-rail :global([data-chapter-rail-lane]),
  .chapter-rail :global([data-chapter-rail-branch]) {
    fill: none;
    stroke: var(--chapter-rail-lane);
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .chapter-rail :global([data-chapter-rail-branch]) {
    transition: stroke var(--chapter-rail-transition);
  }

  .chapter-rail
    :global([data-chapter-rail-branch][data-chapter-rail-accent="main"][data-chapter-rail-state="current"]) {
    stroke: color-mix(in srgb, var(--chapter-rail-current) 78%, transparent);
  }

  .chapter-rail :global([data-chapter-rail-branch][data-chapter-rail-accent="peach"]) {
    stroke: color-mix(in srgb, var(--color-parallel) 34%, transparent);
  }

  .chapter-rail :global([data-chapter-rail-branch][data-chapter-rail-accent="cyan"]) {
    stroke: color-mix(in srgb, var(--color-glyph) 36%, transparent);
  }

  /* Commit nodes. Main-lane dots show progress: passed rows are filled,
     upcoming rows hollow. Worktree dots take their lane's color. */
  .chapter-rail :global(.chapter-rail-commit) {
    fill: var(--color-canvas);
    stroke: var(--chapter-rail-muted);
    stroke-width: 1.5px;
    transition:
      fill var(--chapter-rail-transition),
      stroke var(--chapter-rail-transition);
  }

  .chapter-rail :global([data-chapter-rail-state="passed"] .chapter-rail-commit) {
    fill: var(--chapter-rail-muted);
  }

  .chapter-rail :global([data-chapter-rail-accent="peach"] .chapter-rail-commit) {
    fill: var(--color-parallel);
    stroke: var(--color-parallel);
  }

  .chapter-rail :global([data-chapter-rail-accent="cyan"] .chapter-rail-commit) {
    fill: var(--color-glyph);
    stroke: var(--color-glyph);
  }

  /* The current chapter is a terminal node: a filled primary disc whose halo
     ring pulses outward. Other chapter rows show only their commit node. */
  .chapter-rail :global(.chapter-rail-terminal),
  .chapter-rail :global(.chapter-rail-terminal-halo) {
    display: none;
  }

  .chapter-rail :global([data-chapter-rail-state="current"] .chapter-rail-commit) {
    display: none;
  }

  .chapter-rail :global([data-chapter-rail-state="current"] .chapter-rail-terminal) {
    display: inline;
    fill: var(--chapter-rail-current);
    stroke: var(--chapter-rail-current);
  }

  .chapter-rail :global([data-chapter-rail-state="current"] .chapter-rail-terminal-halo) {
    display: inline;
    fill: none;
    stroke: var(--chapter-rail-current);
    stroke-width: 2px;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: chapter-rail-terminal-halo 3.2s ease-out infinite;
  }

  @keyframes chapter-rail-terminal-halo {
    0% {
      opacity: 0.72;
      transform: scale(1);
    }

    70%,
    100% {
      opacity: 0;
      transform: scale(2.35);
    }
  }

  /* Reduced motion: the halo holds still as a ring around the filled disc. */
  @media (prefers-reduced-motion: reduce) {
    .chapter-rail {
      --chapter-rail-transition: 0s;
    }

    .chapter-rail :global([data-chapter-rail-state="current"] .chapter-rail-terminal-halo) {
      animation: none;
      opacity: 0.72;
      transform: scale(1.6);
    }
  }
</style>
