---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitTerminalLine } from "./recreation-kit-model";

interface Props {
  readonly lines: readonly KitTerminalLine[];
  readonly scenePart?: string | undefined;
}

const { lines, scenePart } = Astro.props;

function splitShellCommand(command: string): { readonly program: string; readonly rest: string } {
  const separatorIndex = command.indexOf(" ");
  return separatorIndex === -1
    ? { program: command, rest: "" }
    : { program: command.slice(0, separatorIndex), rest: command.slice(separatorIndex) };
}
---

<!--
  Scripted terminal output. Every line carries data-line; the text a typing
  tween reveals carries data-kit-typed, so scenes never split strings at run time.
-->
<div class="kit-terminal" {...scenePartAttributes(scenePart)}>
  {
    lines.map((line, lineIndex) => {
      const lineAttributes = {
        "data-line": String(lineIndex),
        "data-line-kind": line.kind,
        ...(line.phoneRole === "hidden" ? { "data-kit-phone": "hidden" } : {}),
        ...scenePartAttributes(line.scenePart),
      };
      switch (line.kind) {
        case "shell-prompt":
          return (
            <div class="kit-terminal__line" {...lineAttributes}>
              <span class="kit-terminal__prompt-glyph">⚡</span>{" "}
              <span class="kit-terminal__arrow">➜</span>{" "}
              <span class="kit-terminal__path">{line.worktreeName}</span>{" "}
              <span class="kit-terminal__branch">
                (<KitIcon name="branch" /> {line.branchName})
              </span>{" "}
              {line.command === undefined ? (
                <span class="kit-terminal__cursor" />
              ) : (
                <span class="kit-terminal__typed" data-kit-typed><span class="kit-terminal__command">{splitShellCommand(line.command).program}</span><span class="kit-terminal__preformatted">{splitShellCommand(line.command).rest}</span></span>
              )}
            </div>
          );
        case "user-message":
          return (
            <div class="kit-terminal__line kit-terminal__line--user" {...lineAttributes}>
              <span class="kit-terminal__marker">›</span>
              <span class="kit-terminal__typed" data-kit-typed>
                {line.text}
              </span>
            </div>
          );
        case "agent-message":
          return (
            <div class="kit-terminal__line kit-terminal__line--agent" {...lineAttributes}>
              <span class="kit-terminal__marker">•</span>
              <span class="kit-terminal__typed" data-kit-typed>
                {line.text}
              </span>
            </div>
          );
        case "agent-activity":
          return (
            <div class="kit-terminal__line kit-terminal__line--activity" {...lineAttributes}>
              <span class="kit-terminal__typed" data-kit-typed>
                {line.text}
              </span>
            </div>
          );
        case "output":
          return (
            <div class="kit-terminal__line" {...lineAttributes}>
              <span class="kit-terminal__typed" data-kit-typed>
                {line.segments.map((segment) => (
                  <span class="kit-terminal__preformatted" data-tone={segment.tone}>{segment.text}</span>
                ))}
              </span>
            </div>
          );
        case "agent-input":
          return (
            <div class="kit-terminal__line kit-terminal__line--input" {...lineAttributes}>
              <span class="kit-terminal__marker">›</span>
              <span class="kit-terminal__cursor" />
            </div>
          );
        case "blank":
          return <div class="kit-terminal__line kit-terminal__line--blank" {...lineAttributes} />;
      }
    })
  }
</div>

<style>
  /* Type and ANSI roles follow the Ghostty panes in parallel-agents.png. */
  .kit-terminal {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0.7em 0.9em;
    overflow: hidden;
    background: var(--kit-canvas);
    color: var(--kit-text);
    font-family: var(--kit-font-mono);
    font-size: 1.02em;
    line-height: 1.55;
  }

  .kit-terminal__line {
    flex: none;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .kit-terminal__line--blank {
    height: 0.8em;
  }

  .kit-terminal__preformatted {
    white-space: pre;
  }

  .kit-terminal__typed {
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    vertical-align: bottom;
  }

  .kit-terminal__line--user {
    margin-block: 0.25em;
    padding: 0.25em 0.5em;
    border-radius: 0.2em;
    background: var(--kit-card);
  }

  .kit-terminal__line--agent .kit-terminal__marker {
    color: var(--kit-text);
  }

  .kit-terminal__line--activity {
    padding-left: 1.2em;
    color: var(--kit-text-faint);
  }

  .kit-terminal__line--input {
    margin-top: auto;
    padding-top: 0.45em;
    border-top: 1px solid var(--kit-separator);
  }

  .kit-terminal__marker {
    display: inline-block;
    width: 1.2em;
    color: var(--kit-text-faint);
  }

  .kit-terminal__prompt-glyph {
    color: var(--kit-ansi-command);
  }

  .kit-terminal__arrow {
    color: var(--kit-ansi-arrow);
  }

  .kit-terminal__path {
    color: var(--kit-ansi-path);
    font-weight: 600;
  }

  .kit-terminal__branch {
    color: var(--kit-ansi-branch);
    font-weight: 600;
  }

  .kit-terminal__command {
    color: var(--kit-ansi-command);
  }

  .kit-terminal__cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.15em;
    vertical-align: -0.2em;
    background: rgb(234 234 234 / 85%);
  }

  [data-tone="muted"] {
    color: var(--kit-text-faint);
  }

  [data-tone="strong"] {
    font-weight: 700;
  }

  [data-tone="path"] {
    color: var(--kit-ansi-path);
  }

  [data-tone="branch"] {
    color: var(--kit-ansi-branch);
  }

  [data-tone="command"] {
    color: var(--kit-ansi-command);
  }

  [data-tone="remote"] {
    color: var(--kit-ansi-remote);
  }

  [data-tone="added"] {
    color: var(--kit-added);
  }

  [data-tone="removed"] {
    color: var(--kit-removed);
  }

  [data-tone="hash"] {
    color: var(--kit-ansi-hash);
  }

  [data-tone="reference"] {
    color: var(--kit-primary-text);
  }
</style>
