---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitBadge } from "./recreation-kit-model";

interface Props {
  readonly badges: readonly KitBadge[];
  /** "outlined" matches sidebar rows; "bare" matches the pane footer bar. */
  readonly appearance: "outlined" | "bare";
  readonly scenePart?: string | undefined;
}

const { badges, appearance, scenePart } = Astro.props;
---

<span class="kit-badges" data-appearance={appearance} {...scenePartAttributes(scenePart)}>
  {
    badges.map((badge) => {
      switch (badge.kind) {
        case "diff":
          return (
            <span class="kit-badge">
              <span class="kit-badge__dot" />
              <span class="kit-badge__added">+{badge.added}</span>
              <span class="kit-badge__removed">-{badge.removed}</span>
            </span>
          );
        case "sync":
          return (
            <span class="kit-badge kit-badge--sync">
              ↑{badge.ahead} ↓{badge.behind}
            </span>
          );
        case "recency":
          return (
            <span class="kit-badge kit-badge--sync">
              <KitIcon name="clock" />
              {badge.label}
            </span>
          );
        case "pull-requests":
          return (
            <span class="kit-badge kit-badge--pull-requests">
              <KitIcon name="pull-request" />
              {badge.count}
            </span>
          );
      }
    })
  }
</span>

<style>
  .kit-badges {
    display: inline-flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 0.35em;
    font-size: 0.86em;
    font-weight: 500;
    white-space: nowrap;
  }

  .kit-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
  }

  .kit-badges[data-appearance="outlined"] .kit-badge {
    padding: 0.05em 0.45em;
    border: 1px solid var(--kit-outline);
    border-radius: 0.5em;
  }

  .kit-badge__dot {
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: var(--kit-removed);
  }

  .kit-badge__added {
    color: var(--kit-added);
  }

  .kit-badge__removed {
    color: var(--kit-removed);
  }

  .kit-badge--sync {
    color: var(--kit-primary-text);
  }

  .kit-badge--pull-requests {
    color: var(--kit-ansi-hash);
  }
</style>
