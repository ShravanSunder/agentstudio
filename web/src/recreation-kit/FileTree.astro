---
import KitIcon from "./KitIcon.astro";
import type { KitIconName } from "./kit-icon-names";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitFileKind, KitFileTreeRow, KitPhoneRole } from "./recreation-kit-model";

interface Props {
  readonly rows: readonly KitFileTreeRow[];
  /** Which tab of the Files | Review switcher is current. */
  readonly currentView: "files" | "review";
  readonly phoneRole: KitPhoneRole;
  readonly scenePart?: string | undefined;
}

const { rows, currentView, phoneRole, scenePart } = Astro.props;

const fileKindIcons: Readonly<Record<KitFileKind, KitIconName>> = {
  folder: "chevron-down",
  typescript: "file-typescript",
  markdown: "file-markdown",
  document: "file",
};
---

<!-- Files | Review tree panel, as in files.png and review.png. -->
<div
  class="kit-file-tree"
  data-kit-phone={phoneRole === "hidden" ? "hidden" : undefined}
  {...scenePartAttributes(scenePart)}
>
  <div class="kit-file-tree__header">
    <span class="kit-file-tree__switcher">
      <span class="kit-file-tree__view" data-current={currentView === "files" ? "" : undefined}>
        <KitIcon name="files" />Files
      </span>
      <span class="kit-file-tree__view" data-current={currentView === "review" ? "" : undefined}>
        <KitIcon name="review" />Review
      </span>
    </span>
    <span class="kit-file-tree__tools">
      <KitIcon name="sliders" />
      <KitIcon name="search" />
    </span>
  </div>
  <div class="kit-file-tree__rows">
    {
      rows.map((row) => (
        <div
          class="kit-file-tree__row"
          data-kind={row.kind}
          data-selected={row.selected === true ? "" : undefined}
          style={`--kit-tree-depth: ${row.depth}`}
          {...scenePartAttributes(row.scenePart)}
        >
          {row.kind === "folder" ? (
            <KitIcon name={row.expanded === false ? "chevron-right" : "chevron-down"} />
          ) : (
            <KitIcon name={fileKindIcons[row.kind]} class="kit-file-tree__file-icon" />
          )}
          <span class="kit-file-tree__name">{row.name}</span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .kit-file-tree {
    display: flex;
    flex: none;
    flex-direction: column;
    width: 38%;
    min-width: 0;
    overflow: hidden;
    border-left: 1px solid var(--kit-separator);
    background: var(--kit-tree);
  }

  .kit-file-tree__header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    height: 2.8em;
    padding-inline: 0.7em;
    border-bottom: 1px solid var(--kit-separator);
    color: var(--kit-text-supporting);
  }

  .kit-file-tree__switcher {
    display: inline-flex;
    padding: 0.15em;
    border: 1px solid var(--kit-separator);
    border-radius: 0.45em;
  }

  .kit-file-tree__view {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    padding: 0.2em 0.6em;
    border-radius: 0.35em;
    font-size: 0.95em;
  }

  .kit-file-tree__view[data-current] {
    background: var(--kit-primary-tint);
    color: var(--kit-primary-text);
  }

  .kit-file-tree__tools {
    display: inline-flex;
    gap: 0.8em;
  }

  .kit-file-tree__rows {
    display: flex;
    flex-direction: column;
    padding: 0.35em 0.35em;
  }

  .kit-file-tree__row {
    display: flex;
    align-items: center;
    gap: 0.45em;
    height: 2.1em;
    padding-left: calc(0.5em + var(--kit-tree-depth) * 1.1em);
    border: 1px solid transparent;
    border-radius: 0.4em;
    color: var(--kit-text);
    white-space: nowrap;
  }

  .kit-file-tree__row[data-kind="folder"] {
    color: var(--kit-text-supporting);
  }

  .kit-file-tree__row[data-selected] {
    border-color: var(--kit-floating-border);
    background: var(--kit-row-selected);
  }

  .kit-file-tree__row :global(.kit-file-tree__file-icon) {
    color: var(--kit-primary-text);
  }

  .kit-file-tree__name {
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>
