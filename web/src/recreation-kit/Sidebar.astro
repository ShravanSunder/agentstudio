---
import KitBadges from "./KitBadges.astro";
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitPhoneRole, KitSidebarModel } from "./recreation-kit-model";

interface Props {
  readonly sidebar: KitSidebarModel;
  readonly phoneRole: KitPhoneRole;
  readonly filterPlaceholderPart?: string | undefined;
  readonly filterQueryPart?: string | undefined;
  readonly filterClearPart?: string | undefined;
}

const { sidebar, phoneRole, filterPlaceholderPart, filterQueryPart, filterClearPart } =
  Astro.props;
const hasQuery = sidebar.filterQuery !== "";
---

<aside class="kit-sidebar" data-kit-phone={phoneRole === "hidden" ? "hidden" : undefined}>
  <div class="kit-sidebar__filter">
    <KitIcon name="search" />
    <span class="kit-sidebar__filter-text">
      <span
        class="kit-sidebar__filter-placeholder"
        data-kit-presence={hasQuery ? "collapsed" : undefined}
        {...scenePartAttributes(filterPlaceholderPart)}>{sidebar.filterPlaceholder}</span
      >
      <span class="kit-sidebar__filter-query" data-kit-typed {...scenePartAttributes(filterQueryPart)}
        >{sidebar.filterQuery}</span
      >
    </span>
    {
      hasQuery ? (
        <span class="kit-sidebar__filter-clear" {...scenePartAttributes(filterClearPart)}>
          <KitIcon name="close-circle" />
        </span>
      ) : null
    }
  </div>
  <div class="kit-sidebar__controls">
    <KitIcon name="sort" />
    <span class="kit-sidebar__grouping"><KitIcon name="repository" />{sidebar.groupingLabel}</span>
    <KitIcon name="columns" />
    <KitIcon name="trash" />
  </div>
  <p class="kit-sidebar__section">{sidebar.sectionTitle}</p>
  <div class="kit-sidebar__repos">
    {
      sidebar.repos.map((repo) => (
        <div
          class="kit-sidebar__collapsible"
          data-kit-presence={repo.settledPresence === "collapsed" ? "collapsed" : undefined}
          {...scenePartAttributes(repo.scenePart)}
        >
          <div class="kit-sidebar__collapsible-inner">
            <div class="kit-sidebar__repo">
              <KitIcon name="chevron-down" />
              <KitIcon name="repository" />
              <span>{repo.repoName}</span>
            </div>
            {repo.worktrees.map((worktree) => (
              <div
                class="kit-sidebar__collapsible"
                data-kit-presence={worktree.settledPresence === "collapsed" ? "collapsed" : undefined}
                {...scenePartAttributes(worktree.scenePart)}
              >
                <div class="kit-sidebar__collapsible-inner">
                  <div class="kit-sidebar__worktree">
                    <span class="kit-sidebar__worktree-name">
                      <KitIcon name="worktree" class="kit-sidebar__worktree-icon" />
                      <span class="kit-sidebar__ellipsis">{worktree.worktreeName}</span>
                    </span>
                    <span class="kit-sidebar__branch">
                      <KitIcon name="branch" />
                      <span class="kit-sidebar__ellipsis">{worktree.branchName}</span>
                    </span>
                    {worktree.badges.length > 0 ? (
                      <span class="kit-sidebar__badges">
                        <KitBadges badges={worktree.badges} appearance="outlined" />
                      </span>
                    ) : null}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</aside>

<style>
  /* Density follows sidebar-navigation.png and parallel-agents.png. */
  .kit-sidebar {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.55em;
    width: 17.5em;
    padding: 0.35em 0.6em 0.6em;
    overflow: hidden;
    background: var(--kit-chrome);
    font-size: 1em;
  }

  .kit-sidebar__filter {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.45em;
    height: 2.2em;
    padding-inline: 0.6em;
    border-radius: 0.55em;
    background: var(--kit-sidebar-field);
    color: var(--kit-text-faint);
  }

  .kit-sidebar__filter-text {
    display: grid;
    flex: 1 1 0;
    min-width: 0;
  }

  .kit-sidebar__filter-placeholder,
  .kit-sidebar__filter-query {
    grid-area: 1 / 1;
    justify-self: start;
    white-space: pre;
  }

  .kit-sidebar__filter-query {
    color: var(--kit-text);
  }

  .kit-sidebar__controls {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75em;
    color: var(--kit-text-supporting);
  }

  .kit-sidebar__grouping {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.6em;
    border-radius: 0.35em;
    background: var(--kit-primary-tint);
    color: var(--kit-primary);
    font-weight: 500;
  }

  .kit-sidebar__section {
    flex: none;
    margin: 0.4em 0 0;
    padding-inline: 0.2em;
    color: var(--kit-primary);
    font-size: 0.9em;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .kit-sidebar__repos {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  /* Collapsing through grid rows keeps timelines free of layout reads. */
  .kit-sidebar__collapsible {
    display: grid;
    grid-template-rows: 1fr;
  }

  .kit-sidebar__collapsible[data-kit-presence="collapsed"] {
    grid-template-rows: 0fr;
  }

  .kit-sidebar__collapsible-inner {
    min-height: 0;
    overflow: hidden;
  }

  .kit-sidebar__repo {
    display: flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.4em 0.2em;
    color: var(--kit-text-supporting);
    font-size: 1.02em;
    font-weight: 600;
  }

  .kit-sidebar__worktree {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
    padding: 0.35em 0.2em 0.55em 1.6em;
  }

  .kit-sidebar__worktree-name {
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-width: 0;
    font-weight: 500;
  }

  .kit-sidebar__worktree-name :global(.kit-sidebar__worktree-icon) {
    color: var(--kit-ansi-hash);
  }

  .kit-sidebar__branch {
    display: flex;
    align-items: center;
    gap: 0.4em;
    min-width: 0;
    color: var(--kit-text-faint);
    font-size: 0.92em;
  }

  .kit-sidebar__ellipsis {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .kit-sidebar__badges {
    padding-left: 1.3em;
  }

  @container recreation-kit (max-width: 600px) {
    /* The phone crop shows the sidebar or a pane, never both side by side. */
    .kit-sidebar {
      width: 100%;
      padding-inline: 0.7em;
    }

    .kit-sidebar__controls {
      display: none;
    }
  }
</style>
