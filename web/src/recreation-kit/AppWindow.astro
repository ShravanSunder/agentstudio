---
import type { HTMLAttributes } from "astro/types";

import AppToolbar from "./AppToolbar.astro";
import type { KitToolbarModel } from "./recreation-kit-model";
import "./recreation-kit-tokens.css";

interface Props extends Omit<HTMLAttributes<"div">, "class"> {
  readonly toolbar: KitToolbarModel;
  readonly arrangementSuffixPart?: string | undefined;
  readonly class?: string;
}

const { toolbar, arrangementSuffixPart, class: className, ...rootAttributes } = Astro.props;
---

<!--
  The outer element is the kit's size container and the scene root; the host
  stage decides its box. The window inside fills it at the captures' chrome
  proportions.
-->
<div {...rootAttributes} class:list={["recreation-kit", className]}>
  <div class="kit-window">
    <AppToolbar toolbar={toolbar} arrangementSuffixPart={arrangementSuffixPart} />
    <div class="kit-window__body">
      <slot />
    </div>
  </div>
</div>

<style>
  .kit-window {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 12%);
    border-radius: 0.85em;
    background: var(--kit-chrome);
    box-shadow: 0 1.5em 3em rgb(0 0 0 / 35%);
    /* Desktop: roughly 1.3% of the stage per app point, readable at laptop stage widths. */
    font-size: clamp(7px, 1.3cqi, 16px);
    line-height: 1.35;
  }

  .kit-window__body {
    display: flex;
    flex: 1 1 0;
    min-height: 0;
  }

  @container recreation-kit (max-width: 600px) {
    .kit-window {
      /*
       * Phone focused crop: fewer elements, each larger. The 13px floor keeps the
       * kit's smallest role (0.85em) at 11px or more on a 330px phone stage.
       */
      font-size: clamp(13px, 4cqi, 16px);
      border-radius: 0.7em;
    }
  }
</style>
