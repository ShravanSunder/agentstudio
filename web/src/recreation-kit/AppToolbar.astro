---
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitToolbarModel } from "./recreation-kit-model";

interface Props {
  readonly toolbar: KitToolbarModel;
  /** Scene part for the arrangement chip's suffix, e.g. the Pane Zoom marker. */
  readonly arrangementSuffixPart?: string | undefined;
}

const { toolbar, arrangementSuffixPart } = Astro.props;
---

<div class="kit-toolbar">
  <div class="kit-toolbar__traffic" aria-hidden="true">
    <span class="kit-toolbar__light kit-toolbar__light--close"></span>
    <span class="kit-toolbar__light kit-toolbar__light--minimize"></span>
    <span class="kit-toolbar__light kit-toolbar__light--zoom"></span>
  </div>
  <div class="kit-toolbar__cluster" data-kit-phone="hidden">
    <span class="kit-toolbar__glyph"><KitIcon name="repository" /></span>
    <span class="kit-toolbar__glyph"><KitIcon name="bell" /></span>
    <span class="kit-toolbar__divider"></span>
    <span class="kit-toolbar__round"><KitIcon name="folder-plus" /></span>
    <span class="kit-toolbar__round"><KitIcon name="layout-grid" /></span>
  </div>
  <span class="kit-toolbar__arrangement">
    <KitIcon name="arrangement" />
    <span>{toolbar.arrangementLabel}</span>
    {
      toolbar.arrangementSuffix === undefined ? null : (
        <span class="kit-toolbar__arrangement-suffix" {...scenePartAttributes(arrangementSuffixPart)}>
          · {toolbar.arrangementSuffix}
        </span>
      )
    }
  </span>
  <span class="kit-toolbar__divider" data-kit-phone="hidden"></span>
  <div class="kit-toolbar__tabs">
    {
      toolbar.tabs.map((tab) => (
        <span
          class="kit-toolbar__tab"
          data-selected={tab.selected ? "" : undefined}
          data-kit-phone={tab.selected ? undefined : "hidden"}
        >
          <span class="kit-toolbar__tab-title">{tab.title}</span>
          <span class="kit-toolbar__tab-shortcut">⌘{tab.shortcutNumber}</span>
        </span>
      ))
    }
  </div>
  <div class="kit-toolbar__cluster" data-kit-phone="hidden">
    <span class="kit-toolbar__glyph"><KitIcon name="chevron-left" /></span>
    <span class="kit-toolbar__glyph"><KitIcon name="chevron-right" /></span>
    <span class="kit-toolbar__glyph kit-toolbar__count"><KitIcon name="stack" />{toolbar.tabCount}</span>
    <span class="kit-toolbar__divider"></span>
    <span class="kit-toolbar__round"><KitIcon name="plus" /></span>
  </div>
</div>

<style>
  /* Geometry follows the 1280-point captures' toolbar; one em is one app point. */
  .kit-toolbar {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75em;
    height: 3.1em;
    padding-inline: 0.9em 0.7em;
    background: var(--kit-chrome);
    color: var(--kit-text-supporting);
    font-size: 1em;
    white-space: nowrap;
  }

  .kit-toolbar__traffic {
    display: flex;
    flex: none;
    gap: 0.5em;
  }

  .kit-toolbar__light {
    width: 0.95em;
    height: 0.95em;
    border-radius: 50%;
    background: var(--kit-traffic-close);
  }

  .kit-toolbar__light--minimize {
    background: var(--kit-traffic-minimize);
  }

  .kit-toolbar__light--zoom {
    background: var(--kit-traffic-zoom);
  }

  .kit-toolbar__cluster {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.75em;
  }

  .kit-toolbar__glyph {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    font-size: 1.05em;
  }

  .kit-toolbar__count {
    font-size: 0.95em;
    font-weight: 600;
  }

  .kit-toolbar__round {
    display: inline-grid;
    place-items: center;
    width: 2.1em;
    height: 2.1em;
    border: 1px solid var(--kit-outline);
    border-radius: 50%;
    background: var(--kit-toolbar-control);
    color: var(--kit-text);
  }

  .kit-toolbar__divider {
    flex: none;
    width: 1px;
    height: 1.3em;
    background: var(--kit-separator);
  }

  .kit-toolbar__arrangement {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.45em;
    height: 2.1em;
    padding-inline: 0.75em 0.9em;
    border: 1px solid var(--kit-outline);
    border-radius: 1.05em;
    background: var(--kit-toolbar-control);
    color: var(--kit-text);
    font-size: 0.95em;
    font-weight: 500;
  }

  .kit-toolbar__tabs {
    display: flex;
    flex: 1 1 0;
    gap: 0.35em;
    min-width: 0;
    overflow: hidden;
  }

  .kit-toolbar__tab {
    display: flex;
    flex: 1 1 0;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    min-width: 0;
    height: 2.3em;
    padding-inline: 0.9em;
    border-radius: 0.8em;
    color: var(--kit-text-supporting);
    font-size: 1.02em;
  }

  .kit-toolbar__tab[data-selected] {
    background: var(--kit-tab-selected);
    color: var(--kit-text);
  }

  .kit-toolbar__tab-title {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .kit-toolbar__tab-shortcut {
    flex: none;
    color: var(--kit-text-faint);
    font-size: 0.85em;
  }

  @container recreation-kit (max-width: 600px) {
    .kit-toolbar {
      gap: 0.5em;
      height: 2.8em;
      padding-inline: 0.7em;
    }

    /* The phone crop shows one tab; its name matters more than its shortcut. */
    .kit-toolbar__tab-shortcut {
      display: none;
    }
  }
</style>
