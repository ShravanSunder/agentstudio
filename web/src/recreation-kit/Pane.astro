---
import KitBadges from "./KitBadges.astro";
import KitIcon from "./KitIcon.astro";
import { scenePartAttributes } from "./recreation-kit-dom";
import type { KitPaneFooterModel, KitPhoneRole } from "./recreation-kit-model";

interface Props {
  readonly footer: KitPaneFooterModel;
  readonly phoneRole: KitPhoneRole;
  /** Renders the current-pane focus ring (the site's #409CFF focus meaning). */
  readonly focused?: boolean | undefined;
  readonly scenePart?: string | undefined;
  readonly focusRingPart?: string | undefined;
  readonly footerBadgesPart?: string | undefined;
  readonly zoomedChipPart?: string | undefined;
  readonly class?: string | undefined;
}

const {
  footer,
  phoneRole,
  focused = false,
  scenePart,
  focusRingPart,
  footerBadgesPart,
  zoomedChipPart,
  class: className,
} = Astro.props;
const hasDrawer = Astro.slots.has("drawer");
---

<section
  class:list={["kit-pane", className]}
  data-kit-phone={phoneRole === "hidden" ? "hidden" : undefined}
  {...scenePartAttributes(scenePart)}
>
  <div class="kit-pane__content">
    <slot />
  </div>
  {
    hasDrawer ? (
      <div class="kit-pane__drawer-slot">
        <slot name="drawer" />
      </div>
    ) : null
  }
  <footer class="kit-pane__footer">
    <span class="kit-pane__footer-group" data-kit-phone="hidden">
      <KitIcon name="drawer" />
      <KitIcon name="plus" />
      <KitIcon name="pencil" />
    </span>
    <span class="kit-pane__footer-group kit-pane__footer-group--end">
      <KitBadges badges={footer.badges} appearance="bare" scenePart={footerBadgesPart} />
      <span data-kit-phone="hidden"><KitIcon name="pull-request" /></span>
      <span data-kit-phone="hidden"><KitIcon name="code" /></span>
      <span data-kit-phone="hidden"><KitIcon name="copy" /></span>
      {
        footer.zoomed ? (
          <span class="kit-pane__zoomed" {...scenePartAttributes(zoomedChipPart)}>
            <KitIcon name="zoom" />
            Zoomed
          </span>
        ) : (
          <KitIcon name="zoom" />
        )
      }
    </span>
  </footer>
  {focused ? <span class="kit-pane__focus-ring" {...scenePartAttributes(focusRingPart)} /> : null}
</section>

<style>
  .kit-pane {
    position: relative;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    background: var(--kit-canvas);
  }

  .kit-pane__content {
    flex: 1 1 0;
    min-height: 0;
    overflow: hidden;
  }

  .kit-pane__drawer-slot {
    display: flex;
    flex: 0 0 46%;
    min-height: 0;
    overflow: hidden;
  }

  .kit-pane__footer {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 0.8em;
    height: 2.3em;
    padding-inline: 0.8em;
    background: var(--kit-pane-footer);
    color: var(--kit-text-faint);
    white-space: nowrap;
  }

  .kit-pane__footer-group {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.9em;
    min-width: 0;
  }

  /* In a narrow pane the status group yields and clips instead of overlapping. */
  .kit-pane__footer-group--end {
    flex: 0 1 auto;
    justify-content: flex-end;
    overflow: hidden;
  }

  .kit-pane__zoomed {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.6em;
    border-radius: 0.35em;
    background: var(--kit-primary-tint);
    color: var(--kit-primary);
    font-weight: 500;
  }

  .kit-pane__focus-ring {
    position: absolute;
    inset: 0;
    border: 1px solid rgb(64 156 255 / 70%);
    pointer-events: none;
  }
</style>
