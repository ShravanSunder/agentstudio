---
interface Props {
  readonly class?: string | undefined;
}

const { class: className } = Astro.props;
---

<!-- Main panes side by side on the pane gutter, as in parallel-agents.png. -->
<div class:list={["kit-pane-grid", className]}>
  <slot />
</div>

<style>
  .kit-pane-grid {
    display: flex;
    flex: 1 1 0;
    gap: 0.35em;
    min-width: 0;
    min-height: 0;
    padding: 0.1em 0.35em 0.35em;
    background: var(--kit-pane-gutter);
  }
</style>
