---
import { marketingCopy } from "@/marketing-copy";
---

<footer
  class="mx-page-inline grid justify-items-center gap-y-4 border-t border-[rgb(255_255_255/10%)] pt-10 pb-[87px] font-mono-product text-[13px] tracking-wider text-ink-faint max-phone:text-[11px] max-phone:tracking-normal"
>
  <!-- 87px leaves just enough room to frame the final rail branch above 75% of a 1920×1080 viewport at the page bottom. -->
  <nav
    class="flex w-full items-center justify-end gap-x-7 max-md:grid max-md:justify-center max-md:justify-items-center max-md:gap-y-4"
    aria-label="Product credits and links"
  >
    <a class="whitespace-nowrap hover:text-ink-muted" href={marketingCopy.ghosttyUrl}
      >{marketingCopy.finalCallToAction.technologyCredit.trim()}</a
    >
    <a
      class="whitespace-nowrap hover:text-ink-muted"
      href={marketingCopy.socialLinks.x.url}
      >{marketingCopy.finalCallToAction.creatorPrefix}{marketingCopy.finalCallToAction.creatorName}</a
    >
  </nav>
</footer>
