---
import { marketingCopy } from "@/marketing-copy";
---

<footer
  class="mx-page-inline grid justify-items-center gap-y-4 border-t border-[rgb(255_255_255/10%)] py-10 font-mono-product text-[13px] tracking-wider text-ink-faint max-phone:text-[11px] max-phone:tracking-normal"
>
  <nav
    class="flex w-full items-center justify-end gap-x-7 max-md:grid max-md:justify-items-center max-md:gap-y-4"
    aria-label="Product credits and links"
  >
    <a class="whitespace-nowrap hover:text-ink-muted" href={marketingCopy.ghosttyUrl}
      >{marketingCopy.finalCallToAction.technologyCredit.trim()}</a
    >
    <a
      class="whitespace-nowrap hover:text-ink-muted"
      href={marketingCopy.socialLinks.x.url}
      >{marketingCopy.finalCallToAction.creatorPrefix}{marketingCopy.finalCallToAction.creatorName}</a
    >
  </nav>
</footer>
