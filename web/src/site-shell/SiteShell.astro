---
import appLogo from "@/assets/brand/app-logo-transparent.svg";
import GitHubMark from "@/github-action/GitHubMark.astro";
import { marketingCopy } from "@/marketing-copy";
import XMark from "@/social-links/XMark.astro";
import "@/styles/global.css";

interface Props {
  readonly title: string;
  readonly description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2E3036" />
    <title>{title}</title>
  </head>
  <body>
    <header
      class="site-header sticky top-px z-20 mx-auto flex min-h-18 w-[min(calc(100%-32px),var(--container-frame))] items-center justify-between rounded-floating-shell border border-[rgb(137_180_250/24%)] px-page-inline py-4 max-site-edge:w-[calc(100%-2px)]"
      data-site-header
      data-visual-state="resting"
    >
      <a
        class="brand-link inline-flex items-center gap-3 font-bold"
        href="#top"
        aria-label={marketingCopy.navigation.homeLabel}
      >
        <img src={appLogo.src} width="32" height="32" alt="" />
        <span>{marketingCopy.productName}</span>
      </a>
      <nav
        class="flex items-center gap-2 text-[14px] text-ink-muted max-phone:gap-1"
        aria-label={marketingCopy.navigation.primaryLabel}
      >
        <a
          class="header-social-action grid size-8 place-items-center hover:text-ink"
          href={marketingCopy.githubUrl}
          aria-label={marketingCopy.navigation.githubAction}
        >
          <GitHubMark />
        </a>
        <a
          class="header-social-action grid size-8 place-items-center hover:text-ink [&_.social-mark]:size-4"
          href={marketingCopy.socialLinks.x.url}
          aria-label={marketingCopy.socialLinks.x.label}
        >
          <XMark />
        </a>
      </nav>
    </header>
    <div class="site-header-frost" aria-hidden="true"></div>
    <div
      class="site-frame relative z-[1] mx-auto mb-4 w-[min(calc(100%-32px),var(--container-frame))] overflow-visible bg-[rgb(46_48_54/97%)] max-site-edge:m-0 max-site-edge:w-full"
    >
      <main id="top">
        <slot />
      </main>
    </div>
    <script>
      const floatingHeaderScrollThreshold = 32;
      const siteHeader = document.querySelector<HTMLElement>("[data-site-header]");

      if (siteHeader !== null) {
        let pendingAnimationFrame: number | undefined;

        const synchronizeHeaderVisualState = (): void => {
          siteHeader.dataset["visualState"] =
            window.scrollY > floatingHeaderScrollThreshold ? "floating" : "resting";
        };

        const scheduleHeaderVisualStateUpdate = (): void => {
          if (pendingAnimationFrame !== undefined) {
            return;
          }

          pendingAnimationFrame = window.requestAnimationFrame((): void => {
            pendingAnimationFrame = undefined;
            synchronizeHeaderVisualState();
          });
        };

        synchronizeHeaderVisualState();
        window.addEventListener("scroll", scheduleHeaderVisualStateUpdate, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  @reference "../styles/global.css";

  .site-header {
    background:
      linear-gradient(135deg, rgb(137 180 250 / 7%), transparent 42%, rgb(116 199 236 / 4%)),
      rgb(30 30 46 / 78%);
    box-shadow:
      0 8px 30px rgb(10 11 17 / 16%),
      inset 0 1px rgb(255 255 255 / 7%);
    backdrop-filter: blur(20px) saturate(120%);
    -webkit-backdrop-filter: blur(20px) saturate(120%);
    transition:
      top 280ms cubic-bezier(0.22, 1, 0.36, 1),
      width 360ms cubic-bezier(0.22, 1, 0.36, 1),
      min-height 280ms cubic-bezier(0.22, 1, 0.36, 1),
      padding 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-radius 360ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms ease,
      background-color 280ms ease,
      box-shadow 360ms ease;
  }

  .site-header[data-visual-state="floating"] {
    @apply top-3 min-h-16 rounded-floating-shell px-5.5 py-3;
    width: min(80vw, 672px);
    border-color: rgb(137 180 250 / 38%);
    background:
      linear-gradient(135deg, rgb(137 180 250 / 11%), transparent 40%, rgb(116 199 236 / 6%)),
      rgb(30 30 46 / 88%);
    box-shadow:
      0 20px 46px rgb(8 9 14 / 28%),
      0 6px 16px rgb(10 11 17 / 18%),
      0 1px 0 rgb(137 180 250 / 8%),
      inset 0 1px rgb(255 255 255 / 10%);
  }

  .site-header-frost {
    @apply h-9;
    position: fixed;
    z-index: 19;
    top: 0;
    left: 50%;
    width: min(80vw, 672px);
    pointer-events: none;
    opacity: 0;
    background: transparent;
    transform: translateX(-50%);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    mask-image: linear-gradient(
      to right,
      transparent 0,
      #000 8px,
      #000 calc(100% - 8px),
      transparent 100%
    );
    transition: opacity 240ms ease;
  }

  .site-header[data-visual-state="floating"] + .site-header-frost {
    opacity: 1;
  }

  @media (max-width: 620px) {
    .site-header[data-visual-state="floating"] {
      @apply px-4.5;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
