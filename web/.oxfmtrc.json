{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "enabled": true
  },
  "sortPackageJson": {
    "enabled": true
  },
  "ignorePatterns": [
    ".agents",
    "dist",
    "node_modules",
    "playwright-report",
    "test-results",
    "images"
  ]
}
